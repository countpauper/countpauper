# Game data not tied to a character sheet 
def load_cards():
    gvars = ['7a5a3d45-7ad0-4db9-9c9a-dc37294a216e', '1eeba3a1-1fd9-4b72-8713-d6475ccfc204']
    gvars += gather_gvars('dh_cards', 'dh_cards')
    feats = dict()
    for gvar in gvars: 
        feats.update(load_json(get_gvar(gvar) or '{}'))
    return feats

def load_classes():
    gvars=['0342d22f-af8d-44d0-811a-5f1ec8049248']
    gvars += gather_gvars('dh_classes', 'dh_classes')
    classes = dict()
    for gvar in gvars: 
        classes.update(load_json(get_gvar(gvar) or '{}'))
    return classes

difficulties=dict(
    trivial=0,
    very_easy=5,
    easy=10,
    average=15,
    hard=20,
    very_hard=25,
    nearly_impossible=30,
    impossible=35
)

def class_features(sub, cls, mastery, features):
    result = []
    for name, card in features.items(): 
        if card.get('class')==cls:
            if feat_sub:=card.get('subclass'):
                if feat_sub==sub and card.get('mastery') <= mastery:
                    result.append(name)
            else:
                result.append(name)
    return result
        
def heritage_features(community, ancestry, features):
    return [name for name,card in features.items() if card.get('ancestry')==ancestry or card.get('community')==community] 

def get_domains(class_info, class_name):
    if cls:=class_info.get(class_name.lower()):
        return cls.get('domains', [])
    else:
        return []

def all_domains(class_info, classes):
    domains=set()
    for cls in classes:
        domains |= set(get_domains(class_info, cls))
    return domains

####################### Character functions ############################
# These functions convert avrae character sheet to Daggerheart sheet
# Parse an avrae attack to get Daggerheart weapon statistics

def sheet(C=character(), var_name=None):
    if var_name:
        sheet = C.get_cvar(var_name) or get_uvar(var_name)
    else:
        sheet = C.get_cvar('dh_sheet') or get_uvar(C.name)
    return load_yaml(sheet) if sheet else None

def save(sheet, C=character(), var_name=None):
    sheet_str = dump_yaml(sheet)
    if var_name:
        if C:
            sheet = C.set_cvar(var_name, sheet_str)
        else:
            set_uvar(var_name, sheet_str)
    else:
        if C:
            sheet = C.set_cvar('dh_sheet', sheet_str)
        else:
            set_uvar('dh_sheet', sheet_str)

# List (of 0 1 or 2 normally) of tuple(subclass, class, mastery)  
def get_class(C=character()):
    # only support one level line
    classes = []
    for cls, mastery in C.levels:
        if not cls:
            continue
        clsinfo = cls.lower().rsplit(' ',maxsplit=1)
        # format of class is expected to be [<sub class>] <class> Class must be one word
        if len(clsinfo)==2:
            classes.append(tuple(clsinfo+[mastery]))
        else:
            classes.append( ("", clsinfo[0], mastery) )
    return classes

# return community, ancestry in lower case 
def get_heritage(C=character()):
    heritage = C.race.lower().split(' ')
    if len(heritage)==1:
        return "unborne", heritage[0]
    else:
        return tuple(heritage) 

# Colaboration with !pronouns alias that gets cvars they them their theirs cvars for easy use in f-strings
def pronouns(C=character()):
    return {form:pronoun(form) for form in ['they','them','their']}

def pronoun(form, C=character()):
    return C.get_cvar(form, form)

