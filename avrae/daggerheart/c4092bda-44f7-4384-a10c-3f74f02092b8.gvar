### For unit testing, import dependencies
try:
    from avrae import * 
except "FeatureNotAvailable":
    pass

def fuzzy_match(input, list):
    input = input.lower()
    if match := [m for m in list if input==m.lower()]:
        return match[0]
    if match := [m for m in list if m.lower().startswith(input)]:
        return match[0]
    if match := [m for m in list if input in m.lower()]:
        return match[0]
    return None 

def sheet(var_name=None):
    c=character()
    if var_name:
        sheet = c.get_cvar(var_name) or get_uvar(var_name)
    else:
        sheet = c.get_cvar('dh_sheet') or get_uvar(c.name)
    return load_yaml(sheet) if sheet else None

def parse_arg(arg):
    if not arg:
        return None 
    if arg[0] == '+':
        return arg[1:]
    return arg

# Parse discord arguments to a summation of dice and bonuses 
# args: a list of strings 
# returns: a list of operand strings split by + and - 
def parse(args):
    # TODO split operators. For now just support spaces 
    return [parse_arg(arg) for arg in args]

# Return dice, die if s is of the format [<dice>=1]<separator><die>
# return empty tuple otherwise 
def parse_die(s, separator='d'):
    parts = s.split(separator, maxsplit=1)
    if len(parts)==1:
        return tuple()
    if not parts[1][0].isnumeric():
        return tuple()
    try:
        die = parts[1]
        if not parts[0]:
            return 1, die
        else:
            return int(parts[0]), die
    except 'ValueError':
        return tuple()

def parse_hope(s):
    return parse_die(s, 'h')

def parse_fear(s):
    return parse_die(s, 'f')

difficulties=dict(
    trivial=0,
    very_easy=5,
    easy=10,
    average=15,
    hard=20,
    very_hard=25,
    nearly_impossible=30,
    impossible=35
)

def parse_goal(s):
    if s[0] != '=':
        return None 
    s=s[1:]
    if not s:
        return []
    if match:=fuzzy_match(s, difficulties.keys()):
        value = difficulties.get(match)
        return [f"{value}[{match.replace('_',' ')}"]
    return [s]

def agility(c=character()):
    return c.stats.dexterity

def strength(c=character()):
    return c.stats.strength

def finesse(c=character()):
    return c.stats.constitution

def instinct(c=character()):
    return c.stats.wisdom 

def presence(c=character()):
    return c.stats.charisma 

def knowledge(c=character()):
    return c.stats.intelligence 

str_name="strength"
agi_name="agility"
fin_name="finesse"
ins_name="instinct"
pres_name="presence"
know_name="knowledge"

def trait(name):
    if len(name)<3:
        return None
    name=name.lower()
    if str_name.startswith(name):
        return str_name, strength()
    elif agi_name.startswith(name):
        return agi_name, agility()
    elif fin_name.startswith(name):
        return fin_name, finesse()
    elif ins_name.startswith(name):
        return ins_name, instinct()
    elif pres_name.startswith(name):
        return pres_name, presence()
    elif know_name.startswith(name):
        return know_name, knowledge()
    else:
        return None

def experience(sheet, name):
    if not sheet:
       return None
    exp = sheet.get('experience', dict())
    options=[(k,v) for k,v in exp.items() if name.lower() in k.lower()]
    if not options:
        return None
    name, val = options[0]
    if dnd_skill := character().skills[val]:
        return name, dnd_skill.value
    else:
        return name, val


def sum_dice(*dice):
    return '+'.join(die for die in dice if die!='0')

# Sort operands into hope rolls, fear rolls and bonus rolls
## and return the result as a dictionary with hope, fear and bonus list
## Experiences and traits are replaced with strings
def duality(sheet, operands, hope=['1d12'], fear=['1d12']):
    hope_dice = []
    fear_dice = []
    bonus_dice = []
    goals = []
    advantage = 0
    disadvantage = 0
    for operand in operands: 
        if dice:= parse_hope(operand):
            hope_dice.append(f'{dice[0]}d{dice[1]}')
        elif dice:=parse_fear(operand):
            fear_dice.append(f'{dice[0]}d{dice[1]}')
        elif (goal:=parse_goal(operand)) is not None:
            goals.append(goal)   # from here on bonuses are for the last goal
        elif sheet and (dice:=parse_die( operand)):
            if goals:
                goals[-1].append(operand) 
            else:
                bonus_dice.append(f'{dice[0]}d{dice[1]}')
        elif sheet and (trait_bonus:=trait(operand)) is not None:
            bonus_dice.append(f'{trait_bonus[1]}[{trait_bonus[0]}]')
        elif sheet and (exp_bonus:=experience(sheet, operand)) is not None:
            bonus_dice.append(f'{exp_bonus[1]}[{exp_bonus[0]}]')
        elif 'advantage'.startswith(operand.lower()):
            advantage += 1
        elif 'disadvantage'.startswith(operand.lower()):
            disadvantage += 1
        elif goals: 
            goals[-1].append(operand) 
        else:
            bonus_dice.append(operand)
        
    if advantage > disadvantage: 
        bonus_dice.append('1d6[advantage]')
    elif disadvantage > advantage:
        bonus_dice.append('-1d6[disadvantage]')
    return dict(hope=hope_dice or hope, fear=fear_dice or fear, bonus=bonus_dice, goals=goals)   

# vroll each part and return individually
# All dice are supposed to be a list. 
# If hope is empty, fear is the DM die 
# If fear is empty hope is the reaction die (2d12)
def roll_em(hope=None, fear=None, bonus=[], goals=[]):
    result = dict()
    if hope and fear:
        result['hope'] = vroll(sum_dice(*hope)+'[hope]')
        result['fear'] = vroll(sum_dice(*fear)+'[fear]')
    elif hope:
        result['hope'] = vroll(sum_dice(*hope))
    elif fear: 
        result['fear'] = vroll(sum_dice(*fear))
    
    if bonus:
        result['bonus'] = vroll(sum_dice(*bonus))

    result['goals'] = [vroll(sum_dice(*g)) for g in goals]
    return result

def all_goals(goals):
    return {goal_roll:2 for goal_roll in goals}

def interpret_goals(total, goals):
    return {goal_roll:total >= goal_roll.total for goal_roll in goals}


# Return <total>,<type> where type is hope, fear, critical and total is all dice added together
def interpret(hope=None, fear=None, bonus=None, goals=[]):
    total = bonus.total if bonus else 0 
    if hope and fear:
        total += hope.total + fear.total
        if hope.total == fear.total:
                return total, "critical", all_goals(goals)
        elif hope.total > fear.total:
            return total, "hope", interpret_goals(total, goals)
        else: 
            return total, "fear", interpret_goals(total, goals)
    elif fear:      # GM dice, only fear 
        total += fear.total
        if fear.result.crit == 1:
            return total, True, all_goals(goals)
        else:
            return total, False, interpret_goals(total, goals)


def try_mod_cc(name, amt):
    try:
        cc=character().cc(name)
        diff = cc.value
        diff = cc.mod(amt) - diff
        return f"{cc.full_str(True)} {'+' if diff>=0 else ''}{diff}"
    except 'ConsumableException':
        return None

# Increase (or descrease) hope counter
# returns a string description of the new stress and modifier
def hope(amt=1):
    return try_mod_cc('Hope', amt)

# Increase (or decrease) stress counter
# returns a string description of the new stress and modifier
def stress(amt=1):
    return try_mod_cc('Stress', amt)

def roll_damage(dice, success):
    if not success:
        return None # miss
    elif success==1:
        return vroll(dice)
    else:
        return vroll(dice)  # TODO crit damage

def damage_targets(targets, damage_dice):
    return {target:roll_damage(success, damage_dice) for target, success in targets.items()}

degrees=['Failure', 'Success', 'Critical']
def format_goals(goals, separator='\n'):
    return separator.join(f"VS {goal} **{degrees[success]}!**" for goal, success in goals.items())

def format_damage(damages, separator='\n'):
    return separator.join(f"VS {target} **{damage or 'miss'}**" for target, damage in damages.items())


def format_bonus(bonus):
    if not bonus:
            return None
    desc = str(bonus.dice)
    if desc[0] in '+-':
        return desc
    else:
        return '+ '+desc

def format_effects(effects, separator='\n'):
    return separator.join(effect for effect in effects if effect is not None)

def parse_attack(attack_raw):
    if automation:= attack_raw.get('automation'):
        for auto in automation:
            for effect in auto.get('effects',[]): 
                if effect.get('type') == 'attack':
                    for hit in effect.get('hit',[]):
                        if hit.get('type') == 'damage':
                            return effect.get('attackBonus'), hit.get('damage')

    return None, None
