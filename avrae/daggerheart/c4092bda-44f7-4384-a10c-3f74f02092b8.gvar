        desc="""When you take damage you can mark one Armor Slot to reduce the severity of the damage by one threshold.""",
    )
)

def update_cc(C, name, newmax, **kwargs):
    oldmax = 0
    try:
        cc = C.cc(name)
        delta = newmax - cc.max 
        if not delta:
            return cc, delta
        definition=dict(
            initial_value=cc.value if cc.reset_to else cc.value + delta,
            desc=cc.desc,
            dispType=cc.display_type,
            reset_to=cc.reset_to,
            reset_by=cc.reset_by,
            reset=cc.reset_on
        )
        C.delete_cc(name)
    except 'ConsumableException':
        definition=dict()
        definition.update(cc_definition.get(name,dict()))
        delta = None
    definition['minVal'] = '0'
    definition['maxVal'] = f'{newmax}'
    definition.update(kwargs)
    return C.create_cc(name, **definition), delta

def try_mod_cc(C, name, amt):
    try:
        cc=C.cc(name)
        if amt:
            diff = cc.value
            diff = cc.mod(amt) - diff
            return f"{cc} {'+' if diff>=0 else ''}{diff}"
        else:
            return cc
    except 'ConsumableException':
        return None

# Increase (or descrease) hope counter
# returns a string description of the new stress and modifier
def hope(amt=0):
    C=character()
    return try_mod_cc(C, 'Hope', amt)
    
# Increase (or decrease) stress counter
# returns a string description of the new stress and modifier
def stress(amt=0):
    C=character()
    return try_mod_cc(C, 'Stress', amt)

# Try to pay all the costs and return the list of result (for format_result) or a failure string
def pay_em(costs, C=character()):
    for cc_name, amt in costs.items():
        try: 
            has = C.get_cc(cc_name)
        except 'ConsumableException':
            return f"No `{cc_name}`"
        if has<-amt:
            return f"Not enough `{cc_name}` : {has}/{-amt}"
    return [f"**{cc_name}:** {try_mod_cc(C, cc_name, amt)}" for cc_name, amt in costs.items()]

def is_allowed(name, feat, C):
    reasons = dict()
    classes = get_class(C)
    if req_level:=feat.get('level'):
        if req_level > C.levels.total_level:
            reasons['level'] = f"level {req_level}"

    if req_mastery:=feat.get('mastery'):
        if not any(cls[2] < req_mastery for cls in classes):
            reasons['mastery'] = describe_mastery(req_mastery)
    if req_sub:=feat.get('subclass'):
        if not any(cls[0] == req_sub for cls in classes):
            reasons['subclass'] = req_sub
    if req_cls:=feat.get('class'):
        if not any(cls[1] == req_cls for cls in classes):
            reasons['class'] = req_cls

    community, ancestry = get_heritage(C) 
    if req_community:=feat.get('community'):
        if req_community != community:
            reasons['community'] = f'{req_community} community'
    if req_ancestry:=feat.get('ancestry'):
        if req_ancestry != ancestry:
            reasons['ancestry'] = f'{req_ancestry} ancestry'

    if req_domain:=feat.get('domain'):
        class_info = load_classes()
        domains = all_domains(class_info, [cls[1] for cls in classes])
        if req_domain not in domains:
            reasons['domain'] = f'{req_domain} domain'

    if feat.get('category', 'domain'):
        if name in [c.lower() for c in vault(C)]:
            reasons['card'] = f"{name} card in loadout"
        elif name not in [c.lower() for c in loadout(C)]:
            reasons['card'] = f"{name} card"
    return reasons or True
    
# return gold dict with total in float handful 
def gold(C=character()):
    purse = C.coinpurse
    gold = dict(
        handful=purse['ep'],
        bags=purse['sp'],
        chest=purse['gp']
        # NB: pp unused. available for hidden Daggerheart imported number
    )

    total =  gold['handful'] + gold['bags'] * 10 + gold['chest'] * 100
    if coins:=purse['cp']: # reasonable popular homebrew, single coins
        # If not set it is not mentioned in the dict and the total remains integer
        gold['coins'] = coins
        total += 0.1 * coins

    gold['total'] = total
    return gold

# find the index in the string s of the first character not in allowed
# return -1 if it is not found 
def find_first_not_of(s, allowed):
    for i, c in enumerate(s):
        if c not in allowed:
            return i
    return -1

# Split <dicestr>"["<label>"]" label into dicestr,label or dicestr,None if none  
def split_dice_label(dice_str):
    label_start = dice_str.find('[')
    if label_start<0:
        return dice_str, None
    label_end = dice_str.find(']', label_start);
    if label_end < 0:
        label_end=len(dice_str) # Just cut to the end if not closed
    return dice_str[0:label_start], dice_str[label_start+1:label_end]

digits = "0123456789"
# split dice XdY+/-Z[L] into X:int,Y:int,Z:dice,N:str  
def split_dice(dice_str, separator='d'):
    dice_str, label = split_dice_label(dice_str)
    dice_str = dice_str.replace(' ','') 
    dice_parts = dice_str.split(separator,maxsplit=1)
    if len(dice_parts)==1:  # no separator so it's just Z[L]
        return 0, 0, dice_str, label
    dice_count = int(dice_parts[0]) if dice_parts[0] else 1
    die_end = find_first_not_of(dice_parts[1], digits)
    if (die_end<0): # form is 1d4[label], there's no bonus 
        return dice_count, int(dice_parts[1]), None, label
    # end of die size found before end of label 
    die_size=int(dice_parts[1][0:die_end])
    die_bonus=dice_parts[1][die_end:]
    return dice_count, die_size, die_bonus, label

def roll_damage(dice, proficiency, success):
    if not success:
        return None # miss
    dice, die, bonus, label = split_dice(dice)
    dice *= proficiency 
    crit_bonus = f'+{dice*die}' if success>1 else ''
    roll_str=f'{dice}d{die}{crit_bonus}'
    if bonus is not None:
        roll_str+=bonus
    if label is not None:
        roll_str+=f'[{label}]'
    return vroll(roll_str)

def damage_targets(targets, proficiency, damage_dice):
    return {target:roll_damage(damage_dice, proficiency, success) for target, success in targets.items()}

degrees=['Failure', 'Success', 'Critical']
def format_goals(goals, separator='\n'):
    return separator.join(f"VS {goal} **{degrees[success]}!**" for goal, success in goals.items())

def format_damage(damages, separator='\n'):
    return separator.join(f"VS {target} **{damage or 'miss'}**" for target, damage in damages.items())


def format_bonus(bonus):
    if not bonus:
            return None
    desc = str(bonus.dice)
    if desc[0] in '+-':
        return desc
    else:
        return '+ '+desc

def format_effects(effects, separator='\n'):
    return separator.join(effect for effect in effects if effect is not None)

def parse_attack_raw(attack_raw):
    result = dict()
    if automation:= attack_raw.get('automation'):
        for auto in automation:
            if auto.get('type') == 'target':
                for effect in auto.get('effects',[]): 
                    if effect.get('type') == 'attack':
                        result['bonus'] = effect.get('attackBonus')
                        for hit in effect.get('hit',[]):
                            if hit.get('type') == 'damage':
                                result['damage'] = hit.get('damage')
                                break
            elif auto.get('type') == 'text':
                result['feature'] = auto.get('text')
    return result

def parse_attack(atk):
    result = dict(name = atk.name)
    result.update(parse_attack_raw(atk.raw))
    return result

def weapons(C):
    return [parse_attack(atk) for atk in C.attacks]

def loadout(C):
    return [spell.name for spell in C.spellbook.spells if spell.prepared]

def vault(C):
    return [spell.name for spell in C.spellbook.spells if not spell.prepared]
