# Not Daggerheart specific, but avrae alias helpers 
logo = "https://upload.wikimedia.org/wikipedia/en/0/08/Daggerheart_logo_2024.png"

def fuzzy_match(input, list):
    input = input.lower()
    if match := [m for m in list if input==m.lower()]:
        return match[0]
    if match := [m for m in list if m.lower().startswith(input)]:
        return match[0]
    if match := [m for m in list if input in m.lower()]:
        return match[0]
    return None 


def gather_gvars(svar_name, uvar_name):
    return load_yaml(get_uvar(uvar_name,'[]')) +  load_yaml(get_svar(svar_name,'[]'))


# find the index in the string s of the first character not in allowed
# return -1 if it is not found 
def find_first_not_of(s, allowed):
    for i, c in enumerate(s):
        if c not in allowed:
            return i
    return -1

def reset(rests, C=character()):
    result=[]
    for cc in C.consumables:
        if cc.reset_on in rests:
            new, old, target, delta = cc.reset()
            result.append(f"**{cc.name}:** {cc} ({format_delta(delta)})")
    return result

