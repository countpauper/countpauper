## Documentation: https://github.com/countpauper/countpauper/tree/master/avrae/daggerheart/daggerheart_lib.md

### For unit testing, import dependencies
try:
    from avrae import * 
except "FeatureNotAvailable":
    pass


def sheet(var_name=None):
    c=character()
    if var_name:
        sheet = c.get_cvar(var_name) or get_uvar(var_name)
    else:
        sheet = c.get_cvar('dh_sheet') or get_uvar(c.name)
    return load_yaml(sheet) if sheet else None

def parse_arg(arg):
    if not arg:
        return None 
    if arg[0] == '+':
        return arg[1:]
    return arg

# Parse discord arguments to a summation of dice and bonuses 
# args: a list of strings 
# returns: a list of operand strings split by + and - 
def parse(args):
    # TODO split operators. For now just support spaces 
    return [parse_arg(arg) for arg in args]

# Return dice, die if s is of the format [<dice>=1]<separator><die>
# return empty tuple otherwise 
def parse_dice(s, separator='d'):
    parts = s.split(separator, maxsplit=1)
    if len(parts)==1:
        return tuple()
    if not parts[1][0].isnumeric():
        return tuple()
    try:
        die = parts[1]
        if not parts[0]:
            return 1, die
        else:
            return int(parts[0]), die
    except 'ValueError':
        return tuple()

def parse_hope(s):
    return parse_dice(s, 'h')

def parse_fear(s):
    return parse_dice(s, 'f')

def agility(c=character()):
    return c.stats.dexterity

def strength(c=character()):
    return c.stats.strength

def finesse(c=character()):
    return c.stats.constitution

def instinct(c=character()):
    return c.stats.wisdom 

def presence(c=character()):
    return c.stats.charisma 

def knowledge(c=character()):
    return c.stats.intelligence 

str_name="strength"
agi_name="agility"
fin_name="finesse"
ins_name="instinct"
pres_name="presence"
know_name="knowledge"

def trait(name):
    if len(name)<3:
        return None
    name=name.lower()
    if str_name.startswith(name):
        return str_name, strength()
    elif agi_name.startswith(name):
        return agi_name, agility()
    elif fin_name.startswith(name):
        return fin_name, finesse()
    elif ins_name.startswith(name):
        return ins_name, instinct()
    elif pres_name.startswith(name):
        return pres_name, presence()
    elif know_name.startswith(name):
        return know_name, knowledge()
    else:
        return None

def experience(sheet, name):
    if not sheet:
       return None
    exp = sheet.get('experience', dict())
    options=[(k,v) for k,v in exp.items() if name.lower() in k.lower()]
    if not options:
        return None
    name, val = options[0]
    if dnd_skill := character().skills[val]:
        return name, dnd_skill.value
    else:
        return name, val
        
# Sort operands into hope rolls, fear rolls and bonus rolls
## and return the result as a dictionary with hope, fear and bonus list
## Experiences and traits are replaced with strings
def duality(sheet, operands):
    hope_dice = []
    fear_dice = []
    bonus_dice = []
    advantage = 0
    disadvantage = 0
    for operand in operands: 
        if dice:= parse_hope(operand):
            hope_dice.append(f'{dice[0]}d{dice[1]}')
        elif dice:=parse_fear(operand):
            fear_dice.append(f'{dice[0]}d{dice[1]}')
        elif dice:=parse_dice( operand):
            bonus_dice.append(f'{dice[0]}d{dice[1]}')
        elif (trait_bonus:=trait(operand)) is not None:
            bonus_dice.append(f'{trait_bonus[1]}[{trait_bonus[0]}]')
        elif (exp_bonus:=experience(sheet, operand)) is not None:
            bonus_dice.append(f'{exp_bonus[1]}[{exp_bonus[0]}]')
        elif 'advantage'.startswith(operand.lower()):
            advantage += 1
        elif 'disadvantage'.startswith(operand.lower()):
            disadvantage += 1
        else:
            bonus_dice.append(operand)
        
    if advantage > disadvantage: 
        bonus_dice.append('1d6[advantage]')
    elif disadvantage > advantage:
        bonus_dice.append('-1d6[disadvantage]')
    return dict(hope=hope_dice or ['1d12'], fear=fear_dice or ['1d12'], bonus=bonus_dice)   

# vroll each part and return individually
# All dice are supposed to be a list. Hope can nnot be empty 
def roll_em(hope, fear, bonus=[]):
    result = dict()
    if hope:
        result['hope'] = vroll('+'.join(hope)+'[hope]')
    if fear:
        result['fear']=vroll('+'.join(fear)+'[fear]')
    if bonus:
        result['bonus']=vroll('+'.join(bonus))
    return result

# Return <total>,<type> where type is hope, fear, critical and total is all dice added together
def interpret(hope, fear, bonus=None):
    total = hope.total + fear.total
    if (bonus):
        total += bonus.total 
    if hope.total == fear.total:
            return total, "critical"
    elif hope.total > fear.total:
        return total, "hope"
    else: 
        return total, "fear"
