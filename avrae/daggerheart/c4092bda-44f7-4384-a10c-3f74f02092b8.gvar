def get_mapped_score(C, skill):
    return C.skills[skill].value 

# Get damage thresholds, Index is amount of wounds if damage>=treshold 
def thresholds(C=character()):
    thresholds = [
        -2147483648, 1,
        get_mapped_score(C, skills_map[-1]),
        get_mapped_score(C, skills_map[-2])]
    if massive := get_mapped_score(C, skills_map[-3]):  # common homebrew supported 0
        thresholds.append(massive)
    # TODO deadly not yet supported, less common homebrew
    return thresholds

def max_armor(C=character()):
    return get_mapped_score(C, 'initiative')

def armor(C=character()):
    cc_name='Armor'
    armor_cc_desc="When you take damage, you can mark one Armor Slot to reduce the severity of the damage by one threshold."
    try:
        return C.cc(cc_name)
    except 'ConsumableException':
        return None

def max_stress(C=character()):
    return get_mapped_score(C,'persuasion')

def parse_arg(arg):
    if not arg:
        return None 
    if arg[0] == '+':
        return arg[1:]
    return arg

# Parse discord arguments to a summation of dice and bonuses 
# args: a list of strings 
# returns: a list of operand strings split by + and - 
def parse(args):
    # TODO split operators. For now just support spaces 
    return [parse_arg(arg) for arg in args]

# Return dice, die if s is of the format [<dice>=None]<separator><die>
# return empty tuple otherwise 
def parse_die(s, separator='d'):
    parts = s.split(separator, maxsplit=1)
    if len(parts)==1:
        return tuple()
    if not parts[1][0].isnumeric():
        return tuple()
    try:
        die = parts[1]
        if not parts[0]:
            return None, die
        else:
            return int(parts[0]), die
    except 'ValueError':
        return tuple()

def parse_hope(s):
    return parse_die(s, 'h')

def parse_fear(s):
    return parse_die(s, 'f')

difficulties=dict(
    trivial=0,
    very_easy=5,
    easy=10,
    average=15,
    hard=20,
    very_hard=25,
    nearly_impossible=30,
    impossible=35
)

def parse_goal(s):
    if s[0] != '=':
        return None 
    s=s[1:]
    if not s:
        return []
    if match:=fuzzy_match(s, difficulties.keys()):
        value = difficulties.get(match)
        return [f"{value}[{match.replace('_',' ')}"]
    return [s]

def proficiency(c=character()):
    return c.stats.prof_bonus
        
def agility(c=character()):
    return c.stats.dexterity

def strength(c=character()):
    return c.stats.strength

def finesse(c=character()):
    return c.stats.constitution

def instinct(c=character()):
    return c.stats.wisdom 

def presence(c=character()):
    return c.stats.charisma 

def knowledge(c=character()):
    return c.stats.intelligence 

str_name="strength"
agi_name="agility"
fin_name="finesse"
ins_name="instinct"
pres_name="presence"
know_name="knowledge"

def trait(name):
    if len(name)<3:
        return None
    name=name.lower()
    if str_name.startswith(name):
        return str_name, strength()
    elif agi_name.startswith(name):
        return agi_name, agility()
    elif fin_name.startswith(name):
        return fin_name, finesse()
    elif ins_name.startswith(name):
        return ins_name, instinct()
    elif pres_name.startswith(name):
        return pres_name, presence()
    elif know_name.startswith(name):
        return know_name, knowledge()
    else:
        return None

def experiences(sheet, C):
    if not sheet:
        return None
    exp = sheet.get('experience', dict())
    return {exp: (dnd_skill.value if (dnd_skill:=C.skills[val]) else val) for exp, val in exp.items() if exp}

def experience(sheet, name, C=character()):
    if not sheet:
        return None
    exp = experiences(sheet, C)
    options=[(k,v) for k,v in exp.items() if k and name.lower() in k.lower()]+[None]
    return options[0]

experience_nrs=range(1,10)

def add_experience(sheet, name, C):
    if not sheet:
        sheet=dict()
    exp = sheet.get('experience', dict())
    if len(exp) >= len(experience_nrs):
        return name, f"Maximum number of experiences `{len(experience_nrs)}` reached" 
    map=skills_map[len(exp)]
    sheet['experience'].update({name:map})
    return experience(sheet, name, C)

def change_experience(sheet, idx, name, C):
    if not sheet:
        sheet=dict()
    exp = sheet.get('experience', dict())
    if idx >= len(exp): 
        return name, f"Experience `#{idx+min(experience_nrs)}` does not exist."
    exp = {(name if i==idx else old_name):v for i, (old_name,v) in enumerate(exp.items()) }
    sheet['experience'] = exp
    return experience(sheet, name, C)



def class_features(sub, cls, mastery, features):
    result = []
    for name, feat in features.items(): 
        if feat.get('class')==cls:
            if feat_sub:=feat.get('subclass'):
                if feat_sub==sub and feat.get('mastery') <= mastery:
                    result.append(name)
            else:
                result.append(name)
    return result
        
def heritage_features(community, ancestry, features):
    return [name for name,feat in features.items() if feat.get('ancestry')==ancestry or feat.get('community')==community] 

def get_domains(class_info, class_name):
    if cls:=class_info.get(class_name.lower()):
        return cls.get('domains', [])
    else:
        return []

def all_domains(class_info, classes):
    domains=set()
    for cls in classes:
        domains |= set(get_domains(class_info, cls))
    return domains

def sum_dice(*dice):
    return '+'.join(die for die in dice if die!='0')

# Sort operands into hope rolls, fear rolls and bonus rolls
## and return the result as a dictionary with hope, fear and bonus list
## Also add a dictionary with counter costs
## Experiences and traits are replaced with strings
def duality(sheet, operands, hope=['1d12'], fear=['1d12']):
    hope_dice = []
    fear_dice = []
    bonus_dice = []
    goals = []
    cost = dict()
    advantage = 0
    disadvantage = 0
    for operand in operands: 
        if dice:= parse_hope(operand):
            hope_dice.append(f'{dice[0]}d{dice[1]}' if dice[0] is not None else str(dice[1])) 
        elif dice:=parse_fear(operand):
            fear_dice.append(f'{dice[0]}d{dice[1]}' if dice[0] is not None else str(dice[1]))
        elif (goal:=parse_goal(operand)) is not None:
            goals.append(goal)   # from here on bonuses are for the last goal
        elif sheet and (dice:=parse_die( operand)):
            if goals:
                goals[-1].append(operand) 
            else:
                bonus_dice.append(f'{dice[0]}d{dice[1]}')
        elif sheet and (trait_bonus:=trait(operand)) is not None:
            bonus_dice.append(f'{trait_bonus[1]}[{trait_bonus[0]}]')
        elif sheet and (exp_bonus:=experience(sheet, operand)) is not None:
            bonus_dice.append(f'{exp_bonus[1]}[{exp_bonus[0]}]')
            cost['Hope'] = cost.get('Hope', 0) - 1
        elif 'advantage'.startswith(operand.lower()):
            advantage += 1
        elif 'disadvantage'.startswith(operand.lower()):
            disadvantage += 1
        elif goals: 
            goals[-1].append(operand) 
        else:
            bonus_dice.append(operand)
        
    if advantage > disadvantage: 
        bonus_dice.append('1d6[advantage]')
    elif disadvantage > advantage:
        bonus_dice.append('-1d6[disadvantage]')
    return dict(hope=hope_dice or hope, fear=fear_dice or fear, bonus=bonus_dice, goals=goals), cost   

# vroll each part and return individually
# All dice are supposed to be a list. 
# If hope is empty, fear is the DM die 
# If fear is empty hope is the reaction die (2d12)
def roll_em(hope=None, fear=None, bonus=[], goals=[]):
    result = dict()
    if hope and fear:
        result['hope'] = vroll(sum_dice(*hope)+'[hope]')
        result['fear'] = vroll(sum_dice(*fear)+'[fear]')
    elif hope:
        result['hope'] = vroll(sum_dice(*hope))
    elif fear: 
        result['fear'] = vroll(sum_dice(*fear))
    
    if bonus:
        result['bonus'] = vroll(sum_dice(*bonus))

    result['goals'] = [vroll(sum_dice(*g)) for g in goals]
    return result


def format_dice(hope=None, fear=None, bonus=[], goals=[]):
    summation=[]
    if hope and fear:
        summation += [sum_dice(*hope)+'[hope]', sum_dice(*fear)+'[fear]']
    elif hope:
        summation += hope
    elif fear: 
        summation += fear 

    if bonus:
        summation+=bonus
    return sum_dice(*summation)

def all_goals(goals):
    return {goal_roll:2 for goal_roll in goals}

def interpret_goals(total, goals):
    return {goal_roll:total >= goal_roll.total for goal_roll in goals}


# Return <total>,<type> where type is hope, fear, critical and total is all dice added together
def interpret(hope=None, fear=None, bonus=None, goals=[]):
    total = bonus.total if bonus else 0 
    if hope and fear:
        total += hope.total + fear.total
        if hope.total == fear.total:
                return total, "critical", all_goals(goals)
        elif hope.total > fear.total:
            return total, "hope", interpret_goals(total, goals)
        else: 
            return total, "fear", interpret_goals(total, goals)
    elif fear:      # GM dice, only fear 
        total += fear.total
        if fear.result.crit == 1:
            return total, True, all_goals(goals)
        else:
            return total, False, interpret_goals(total, goals)

cc_definition=dict(
    Hope=dict(
        dispType='star',
        desc='Players can use hope to help an ally, utilize an experience, tag team, or active a hope feature.',
        initial_value=2,
        reset_to=0
    ),
    Stress=dict(
        dispType ='bubble',
        desc="""Stress represents how much mental physical and emotional strain a character can endure.
        Some special abilities or effects require the character activating them to mark Stress and the GM can require a PC to mark Stress as a GM move or to represent the consequence of an action roll.
        When a character marks their last Stress, they become Vulnerable until they clear at least 1 Stress.
        When a character must mark or more Stress but can’t they mark HP instead.""",
        initial_value=0,
