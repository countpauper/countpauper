def _get_mapped_score(C, skill):
    skill_rec = C.skills[skill] 
    return skill_rec.value  # No prof check as proficiency isn't imported for initiative

def _get_mapped_save(C, save):
    save_rec = C.saves.get(save)
    return save_rec.value if save_rec.prof else None 


# Get damage thresholds, Index is amount of wounds if damage>=treshold 
def thresholds(C=character()):
    return [-2147483648, 1] + [v for threshold in thresholds_map if (v:=_get_mapped_save(C, threshold)) is not None]

def max_armor(C=character()):
    return _get_mapped_score(C, 'initiative')

def max_stress(C=character()):
    return _get_mapped_save(C,stress_map)

def max_hope(C=character()):
    save_hope = _get_mapped_save(C,hope_map)
    return 6 if save_hope is None else save_hope
    
def proficiency(C=character()):
    return C.stats.prof_bonus


def agility(C=character()):
    return C.stats.dexterity


def strength(C=character()):
    return C.stats.strength


def finesse(C=character()):
    return C.stats.constitution


def instinct(C=character()):
    return C.stats.wisdom 


def presence(C=character()):
    return C.stats.charisma 


def knowledge(C=character()):
    return C.stats.intelligence 

str_name="strength"
agi_name="agility"
fin_name="finesse"
ins_name="instinct"
pres_name="presence"
know_name="knowledge"

def trait(name, C=character()):
    if len(name)<3:
        return None
    name=name.lower()
    if str_name.startswith(name):
        return str_name, strength(C)
    elif agi_name.startswith(name):
        return agi_name, agility(C)
    elif fin_name.startswith(name):
        return fin_name, finesse(C)
    elif ins_name.startswith(name):
        return ins_name, instinct(C)
    elif pres_name.startswith(name):
        return pres_name, presence(C)
    elif know_name.startswith(name):
        return know_name, knowledge(C)
    else:
        return None

def spell_bonus(C=character()):
    return C.spellbook.sab

def experiences(sheet, C):
    if not sheet:
        return None
    exp = sheet.get('experience', dict())
    return {exp: (dnd_skill.value if (dnd_skill:=C.skills[val]) else val) for exp, val in exp.items() if exp}


def experience(sheet, name, C=character()):
    if not sheet:
        return None
    exp = experiences(sheet, C)
    options=[(k,v) for k,v in exp.items() if k and name.lower() in k.lower()]+[None]
    return options[0]

experience_nrs=range(1,10)
def add_experience(sheet, name, C):
    if sheet is None:
        return f"No sheet to add experience {name} to"
    exp = sheet.get('experience', dict())
    if len(exp) >= len(experience_nrs):
        return name, f"Maximum number of experiences `{len(experience_nrs)}` reached" 
    map=experience_map[len(exp)]
    current_exp = sheet.get('experience',dict())
    current_exp.update({name:map})
    sheet['experience'] = current_exp
    return experience(sheet, name, C) 


def change_experience(sheet, idx, name, C):
    if sheet is None:
        return f"No sheet to change experience #{idx}"
    exp = sheet.get('experience', dict())
    if idx >= len(exp): 
        return name, f"Experience `#{idx+min(experience_nrs)}` does not exist."
    exp = {(name if i==idx else old_name):v for i, (old_name,v) in enumerate(exp.items()) }
    sheet['experience'] = exp
    return experience(sheet, name, C)

def is_allowed(name, card, C):
    reasons = dict()
    classes = get_class(C)
    if req_level:=card.get('level'):
        if req_level > C.levels.total_level:
            reasons['level'] = f"level {req_level}"

    if req_mastery:=card.get('mastery'):
        if not any(cls[2] < req_mastery for cls in classes):
            reasons['mastery'] = format_mastery(req_mastery)
    if req_sub:=card.get('subclass'):
        if not any(cls[0] == req_sub for cls in classes):
            reasons['subclass'] = req_sub
    if req_cls:=card.get('class'):
        if not any(cls[1] == req_cls for cls in classes):
            reasons['class'] = req_cls

    community, ancestry = get_heritage(C) 
    if req_community:=card.get('community'):
        if req_community != community:
            reasons['community'] = f'{req_community} community'
    if req_ancestry:=card.get('ancestry'):
        if req_ancestry != ancestry:
            reasons['ancestry'] = f'{req_ancestry} ancestry'

    if req_domain:=card.get('domain'):
        class_info = load_classes()
        domains = all_domains(class_info, [cls[1] for cls in classes])
        if req_domain not in domains:
            reasons['domain'] = f'{req_domain} domain'

    if card.get('category')=='domain':
        if name in [c.lower() for c in vault(C)]:
            reasons['card'] = f"{name} card in loadout"
        elif name not in [c.lower() for c in loadout(C)]:
            reasons['card'] = f"{name} card"
    return reasons or True
    


# Helper for parse_attack
# Parse avrae automation to get Daggerheart weapon statistics: 
# dict(bonus=attackBonus, damage=damage, feature=text)
# If it's not an attack imported from the sheet or made with `!a add`, results are undefined
def _parse_attack_raw(attack_raw):
    result = dict()
    if automation:= attack_raw.get('automation'):
        for auto in automation:
            if auto.get('type') == 'target':
                for effect in auto.get('effects',[]): 
                    if effect.get('type') == 'attack':
                        result['bonus'] = effect.get('attackBonus')
                        for hit in effect.get('hit',[]):
                            if hit.get('type') == 'damage':
                                result['damage'] = hit.get('damage')
                                break
            elif auto.get('type') == 'text':
                result['feature'] = auto.get('text')
    return result


def parse_attack(atk):
    result = dict(name = atk.name)
    result.update(_parse_attack_raw(atk.raw))
    return result


# Get all the weapons of character C 
def weapons(C):
    return [parse_attack(atk) for atk in C.attacks]


# Get the card loadout of character C, which are the avrae spell names that are flagged as prepared
def loadout(C):
    return [spell.name for spell in C.spellbook.spells if spell.prepared]


# Get the card vault of character C, which are the avrae spell names that are not prepared
def vault(C):
    return [spell.name for spell in C.spellbook.spells if not spell.prepared]


# return gold dict with total in float handful 
def gold(C=character()):
    purse = C.coinpurse
    gold = dict(
        handful=purse['ep'],
        bags=purse['sp'],
        chest=purse['gp']
        # NB: pp unused. available for hidden Daggerheart imported number
    )

    total =  gold['handful'] + gold['bags'] * 10 + gold['chest'] * 100
    if coins:=purse['cp']: # reasonable popular homebrew, single coins
        # If not set it is not mentioned in the dict and the total remains integer
        gold['coins'] = coins
        total += 0.1 * coins

    gold['total'] = total
    return gold


cc_definition=dict(
    Hope=dict(
        dispType='star',
        desc='Players can use hope to help an ally, utilize an experience, tag team, or active a hope feature.',
        initial_value=2,
        reset_to=0
    ),
    Stress=dict(
        dispType ='bubble',
        desc="""Stress represents how much mental physical and emotional strain a character can endure.
        Some special abilities or effects require the character activating them to mark Stress and the GM can require a PC to mark Stress as a GM move or to represent the consequence of an action roll.
        When a character marks their last Stress, they become Vulnerable until they clear at least 1 Stress.
        When a character must mark or more Stress but can’t they mark HP instead.""",
        initial_value=0,
