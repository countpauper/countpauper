        dispType='hex',
        desc="""When you take damage you can mark one Armor Slot to reduce the severity of the damage by one threshold.""",
    )
)

def update_cc(C, name, newmax, **kwargs):
    oldmax = 0
    try:
        cc = C.cc(name)
        delta = newmax - cc.max 
        if not delta:
            return cc, delta
        definition=dict(
            initial_value=cc.value if cc.reset_to==0 else max(cc.value, cc.value + delta),
            desc=cc.desc,
            dispType=cc.display_type,
            reset_to=cc.reset_to,
            reset_by=cc.reset_by,
            reset=cc.reset_on
        )
        C.delete_cc(name)
    except 'ConsumableException':
        definition=dict()
        definition.update(cc_definition.get(name,dict()))
        delta = None
    definition['minVal'] = '0'
    definition['maxVal'] = f'{newmax}'
    definition.update(kwargs)
    return C.create_cc(name, **definition), delta


# counter/resource names that run out at maximum instead of at 0
increasing_costs=('stress', 'recall')
def _is_cc_loss(cc, amt):
    if typeof(cc)=='str':
        if cc.lower() in increasing_costs:
            return amt>0
        else:
            return amt<0
    else:   # AliasCustomCounter
        if cc.reset_to is None: # Reset to maximum (eg hope, armor). Trying to decrease is a loss
            return amt<0
        elif cc.reset_to==0:     # Reset to 0 (ie stress), increasing is a loss
            return amt>0

def _is_cc_gain(cc, amt):
    if typeof(cc)=='str':
        if cc.lower() in increasing_costs:
            return amt<0
        else:
            return amt>0
    else:
        if cc.reset_to is None: # Reset to maximum (eg hope, armor). Positive amount is gain
            return amt>0
        elif cc.reset_to==0: # Reset to 0 (ie stress), negative amount is recovery
            return amt<0
    
def try_mod_cc(C, name, amt):
    try:
        cc=C.cc(name)
    except 'ConsumableException':
        return None
    if amt:
        diff = cc.value
        diff = cc.mod(amt, strict=_is_cc_loss(cc, amt)) - diff
        return f"{cc} ({format_delta(diff)})"
    else:
        return cc

# Increase (or descrease) hope counter
# returns a string description of the new stress and modifier
def hope(amt=0, C=character()):
    try:
        return try_mod_cc(C, 'Hope', amt)
    except 'CounterOutOfBounds':
        return f"{try_mod_cc(C, 'Hope', 0)} (+0)"
    
def armor(amt=0, C=character()):
    try:
        return try_mod_cc(C, 'Armor', amt)
    except 'CounterOutOfBounds':
        return f"{try_mod_cc(C, 'Armor', 0)} (+0)"

def hitpoints(amt=0, C=character()):
    if amt:
        hp = C.hp
        C.set_hp(min(C.max_hp, hp + amt))
        return f"{format_hp(C)} ({format_delta(C.hp - hp)})"
    else:
        return format_hp(C)
        
# Increase (or decrease) stress counter
# returns a list of header,effect tuples of the new stress and modifier and hitpoints
def stress(amt=0, C=character()):
    if amt<=0:
        return [('stress', try_mod_cc(C, 'Stress', amt))]
    try:
        cc = C.cc('Stress')
        if cc.value + amt <= cc.max:
            return [('stress', try_mod_cc(C, 'Stress', amt))]
        cc_amt = cc.max-cc.value
        hp_amt = amt-cc_amt
        return [("stress", try_mod_cc(C, 'Stress', cc_amt)), ("hitpoints", hitpoints(-hp_amt))]
    except 'ConsumableException':
        return None
    except 'CounterOutOfBounds':
        return [("stress", f"{try_mod_cc(C, 'Stress', 0)} (+0)")]


# Return True if the character's Stress is at maximum, which would mean they are vulnerable
def is_stressed_out(C):
    try:
        cc = C.cc('Stress')
        return cc.value == cc.max
    except 'ConsumableException':
        return False

####################### Dice functions ##############################################
# 1) Parse alias arguments and card automation to vroll dice instructions
# 2) Execute the rolls and interpret the results like costs and gains
# 3) Apply the results to the character 
def sum_dice(*dice):
    return '+'.join(die for die in dice if die!='0')


def _parse_goal(s):
    if s[0] != '=':
        return None 
    s=s[1:]
    if not s:
        return []
    if match:=fuzzy_match(s, difficulties.keys()):
        value = difficulties.get(match)
        return [f"{value}[{match.replace('_',' ')}"]
    return [s]

def _parse_arg(arg):
    if not arg:
        return None 
    if arg[0] == '+':
        return arg[1:]
    return arg


# Parse discord arguments to a summation of dice and bonuses 
# args: a list of strings 
# returns: a list of operand strings split by + and - 
def parse(args):
    # TODO split operators. For now just support spaces 
    return [_parse_arg(arg) for arg in args]

# Return dice, die if s is of the format [<dice>=None]<separator><die>
# return empty tuple otherwise 
def _parse_die(s, separator='d'):
    parts = s.split(separator, maxsplit=1)
    if len(parts)==1:
        return tuple()
    if not parts[1][0].isnumeric():
        return tuple()
    try:
        die = parts[1]
        if not parts[0]:
            return None, die
        else:
            return int(parts[0]), die
    except 'ValueError':
        return tuple()

def _parse_hope(s):
    return _parse_die(s, 'h')

def _parse_fear(s):
    return _parse_die(s, 'f')

# Sort operands into hope rolls, fear rolls and bonus rolls
## and return the result as a dictionary with hope, fear and bonus list
## Also add a dictionary with counter costs
## Experiences and traits are replaced with strings
def duality(sheet, operands, hope=['1d12'], fear=['1d12']):
    hope_dice = []
    fear_dice = []
    bonus_dice = []
    goals = []
    cost = dict()
    advantage = 0
    disadvantage = 0
    for operand in operands: 
        if dice:= _parse_hope(operand):
            hope_dice.append(f'{dice[0]}d{dice[1]}' if dice[0] is not None else str(dice[1])) 
        elif dice:=_parse_fear(operand):
            fear_dice.append(f'{dice[0]}d{dice[1]}' if dice[0] is not None else str(dice[1]))
        elif (goal:=_parse_goal(operand)) is not None:
            goals.append(goal)   # from here on bonuses are for the last goal
        elif sheet and (dice:=_parse_die( operand)):
            if goals:
                goals[-1].append(operand) 
            else:
                bonus_dice.append(f'{dice[0]}d{dice[1]}')
        elif sheet and (trait_bonus:=trait(operand)) is not None:
            bonus_dice.append(f'{trait_bonus[1]}[{trait_bonus[0]}]')
        elif sheet and (exp_bonus:=experience(sheet, operand)) is not None:
            bonus_dice.append(f'{exp_bonus[1]}[{exp_bonus[0]}]')
            cost['Hope'] = cost.get('Hope', 0) - 1
        elif 'spell'==operand:
            bonus_dice.append(f'{spell_bonus()}[spell]')
        elif 'advantage'.startswith(operand.lower()):
            advantage += 1
        elif 'disadvantage'.startswith(operand.lower()):
            disadvantage += 1
        elif goals: 
            goals[-1].append(operand) 
        else:
            bonus_dice.append(operand)
        
    if advantage > disadvantage: 
        bonus_dice.append('1d6[advantage]')
    elif disadvantage > advantage:
        bonus_dice.append('-1d6[disadvantage]')
    return dict(hope=hope_dice or hope, fear=fear_dice or fear, bonus=bonus_dice, goals=goals), cost   


# vroll each part and return individually
# All dice are supposed to be a list. 
# If hope is empty, fear is the DM die 
# If fear is empty hope is the reaction die (2d12)
def roll_em(hope=None, fear=None, bonus=[], goals=[]):
    result = dict()
    if hope and fear:
        result['hope'] = vroll(sum_dice(*hope)+'[hope]')
        result['fear'] = vroll(sum_dice(*fear)+'[fear]')
    elif hope:
        result['hope'] = vroll(sum_dice(*hope))
    elif fear: 
        result['fear'] = vroll(sum_dice(*fear))
    
    if bonus:
        result['bonus'] = vroll(sum_dice(*bonus))

    result['goals'] = [vroll(sum_dice(*g)) for g in goals]
    return result


def interpret_goals(total, goals):
    return {goal_roll:total >= goal_roll.total for goal_roll in goals}

def all_goals(goals):
    return {goal_roll:2 for goal_roll in goals}

# Return <total>,<type> where type is hope, fear, critical and total is all dice added together
def interpret(hope=None, fear=None, bonus=None, goals=[]):
    total = bonus.total if bonus else 0 
    if hope and fear:
        total += hope.total + fear.total
        if hope.total == fear.total:
                return total, "critical", all_goals(goals)
        elif hope.total > fear.total:
            return total, "hope", interpret_goals(total, goals)
        else: 
            return total, "fear", interpret_goals(total, goals)
    elif fear:      # GM dice, only fear 
        total += fear.total
        if fear.result.crit == 1:
            return total, True, all_goals(goals)
        else:
            return total, False, interpret_goals(total, goals)

# Try to pay all the costs and return the list of result (for format_result) or a failure string
def pay_em(costs, C=character()):
    # Check costs ahead of time, to prevent partial costs failure.
    for cc_name, amt in costs.items():
        try: 
            has = C.get_cc(cc_name)
        except 'ConsumableException':
            return f"No `{cc_name}`"    # TODO: support playing without sheet/counters
        if has<-amt:
            return f"Not enough `{cc_name}` : {has}/{-amt}"
    return [(cc_name, try_mod_cc(C, cc_name, amt)) for cc_name, amt in costs.items()]

def earn_em(quality, C):
    if quality=='hope':
        return [("hope", hope(+1, C))]
    elif quality=='critical':
        return [("hope", hope(+1, C))] + stress(-1, C)
    else:
        return []

# Split <dicestr>"["<label>"]" label into dicestr,label or dicestr,None if none  
def split_dice_label(dice_str):
    label_start = dice_str.find('[')
    if label_start<0:
        return dice_str, None
    label_end = dice_str.find(']', label_start);
    if label_end < 0:
        label_end=len(dice_str) # Just cut to the end if not closed
    return dice_str[0:label_start], dice_str[label_start+1:label_end]

digits = "0123456789"
# split dice XdY+/-Z[L] into X:int,Y:int,Z:dice,N:str  
def split_dice(dice_str, separator='d'):
    dice_str, label = split_dice_label(dice_str)
    dice_str = dice_str.replace(' ','') 
    dice_parts = dice_str.split(separator,maxsplit=1)
    if len(dice_parts)==1:  # no separator so it's just Z[L]
        return 0, 0, dice_str, label
    dice_count = int(dice_parts[0]) if dice_parts[0] else 1
    die_end = find_first_not_of(dice_parts[1], digits)
    if (die_end<0): # form is 1d4[label], there's no bonus 
        return dice_count, int(dice_parts[1]), None, label
    # end of die size found before end of label 
    die_size=int(dice_parts[1][0:die_end])
    die_bonus=dice_parts[1][die_end:]
    return dice_count, die_size, die_bonus, label

def roll_damage(dice, success):
    if not success:
        return None # miss
    dice, die, bonus, label = split_dice(dice)
    roll_str=f'{dice}d{die}'
    if success>1:
        roll_str = (f'{dice}*{die}[crit] + ' if dice>1 else f'{die}[crit] +') + roll_str

    if bonus is not None:
        roll_str+=bonus
    if label is not None:
        roll_str+=f'[{label}]'
    return vroll(roll_str)

def damage_targets(targets, damage_dice):
    return {target:roll_damage(damage_dice, success) for target, success in targets.items()}

#################### Fromating functions ##################
# These convert Daggerheart structures to user facing text

# Format roll without dice as simple totals
def format_roll(roll):
    if roll.dice.isdigit():
        return roll.consolidated()
    else:
        return str(roll)

nl='\n'
degrees=['Failure', 'Success', 'Critical']
def format_goals(goals):
    return [(f"VS {format_roll(goal)}",f"{degrees[success]}!") for goal, success in goals.items()]

def format_damage(damages, separator='\n'):
    return [(f"VS {format_roll(target)}", f"{damage or 'miss'}") for target, damage in damages.items()]


def format_delta(d):
    d=str(d)
    if d[0] in '+-':
        return d
    else:
        return '+ '+ d

def format_bonus(bonus):
    if not bonus:
        return None
    return format_delta(str(bonus.dice))

# Convery a card dict structure to lines of strings to display in an embed
# The last line is the source and can be used as embed footer
def format_card(card_name, card, C):
    lines=[]
    if card.get('category')=='domain':
        lines.append(f"**Level {card.get('level')} {card.get('domain','').capitalize()} {card.get('type','').capitalize()}**")
    else:
        assignment_keys='community','ancestry','subclass','class' 
        assignment=[]
        if level:=card.get('level'):
            assignment.append(f"Level: {level}")
        if mastery:=card.get('mastery'):
            assignment.append(format_mastery(mastery).capitalize())
        assignment+= [v.capitalize() for k,v in card.items() if k in assignment_keys]
        lines.append(f"** {' '.join(assignment)} {card.get('type', '')}**")

    cost_keys='recall', 'hope', 'stress', 'armor'
    # TODO for sub feats combine main card costs and sub card costs 
    if costs:={k:v for k,v in card.items() if k in cost_keys and _is_cc_loss(k, v)}:
        lines.append(' '.join(f"**{k.capitalize()} cost: {abs(v)}**" for k,v in costs.items()))

    allowed = is_allowed(card_name, card, C)
    if allowed is not True: 
        lines.append(f"**Requires:** {', '.join(a.capitalize() for a in allowed.values())}")

    #description 
    lines.append(card.get('description',''))

    if source:=card.get('source'):
        lines.append(f"Source: {source}")
    else:
        lines.append("Source: Unknown")
    return lines

def format_dice(hope=None, fear=None, bonus=[], goals=[]):
    summation=[]
    if hope and fear:
        summation += [sum_dice(*hope)+'[hope]', sum_dice(*fear)+'[fear]']
    elif hope:
        summation += hope
    elif fear: 
        summation += fear 

    if bonus:
        summation+=bonus
    return sum_dice(*summation)

mastery_description=["foundation", "specialist", "master"]
def format_mastery(mastery):
    if mastery<=0:
        return "" 
    return mastery_description[mastery-1]


def format_hp(C=character()):
    hp = C.hp
    missing_hp = C.max_hp - C.hp
    return f"{'♥' * hp}{'♡' * missing_hp}"

# a noun or an noun. It's not 100% but the exceptions (e.g. hour and eulogy) are not likely to occur in a game context
def indefinite_article(noun):
    noun = str(noun).lower()
    if noun[0] in "aeiou":
        return f"an {noun}"
    else:
        return f"a {noun}"
    
# output with a simple echo
# title, dice, bonus and result should be user facing string as from the various format_x(...) functions 
# or convertable to a huamn readable string
# effects and targets are lists of tuples (head, body) of user facing strings
def echo(title, dice, bonus, result, effects=[], targets=[]):
    out =  f"echo __{title}__{nl}{dice}"
    if bonus:
        out+=" "+bonus
    if result:
        out+= ": " + result
    if effects:
        out += nl + nl.join(f"**{head.capitalize()}:** {body}" for head, body in effects)
    if targets:
        out += nl + nl.join(f"**{head.capitalize()}:** {body}" for head, body in targets)
    return out

def embed(title, thumb, dice, bonus, result, effects=[], targets=[]):
    desc = str(dice)
    if bonus:
        desc+=" "+bonus
    if result:
        desc+= ": " + result
    image = f"-thumb {thumb}" if thumb else ""
    fields=[f"""-f "{head.capitalize()}|{body}" """ for head, body in targets]
    fields+=[f"""-f "{head.capitalize()}|{body}|inline" """ for head, body in effects]
    return f"""embed -title "{title}" -desc "{desc}" {image} {''.join(fields)}"""
