<drac2> 
using(dh="c4092bda-44f7-4384-a10c-3f74f02092b8")

args=&ARGS& 
C=character()
lines=[]
unknown=[]
for arg in args: 
    arg=arg.lower()
    roll_str = f'1d4+{dh.proficiency(C)}'
    if arg=='heal':
        heal_roll=vroll(roll_str)
        lines.append(f"**Tend to ally's wounds:** {heal_roll}")
    elif arg=='health' or arg=='hp':
        heal_roll=vroll(f'1d4+{dh.proficiency(C)}')
        lines.append(f"**Tend to wounds:** {heal_roll} {dh.hitpoints(heal_roll.total)}")
    elif 'armor'.startswith(arg):
        armor_roll = vroll(roll_str)
        lines.append(f"**Repair armor:** {armor_roll} {dh.armor(armor_roll.total)}")
    elif 'stress'.startswith(arg):
        stress_roll = vroll(roll_str)
        lines.append(f"**Clear stress:** {stress_roll} {dh.stress(-stress_roll.total)}")
    elif arg=='hope':
        lines.append(f"**Prepare: Hope** {dh.hope(+1)}")
    elif arg=='hopes':
        lines.append(f"**Prepare together: Hope** {dh.hope(+2)}")
    else:
        lines.append(f"**Unrecognized action:** `{arg}`")

for counter in dh.reset(['short'], C):
    lines.append(str(counter))

nl='\n'

return f"""embed -title "{C.name} takes a short rest." -desc "{nl.join(lines)}" """
</drac2>

