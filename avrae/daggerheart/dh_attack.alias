<drac2>
using(dh="c4092bda-44f7-4384-a10c-3f74f02092b8")

def find_attack(c, name):
    attacks = {a.name:a for a in c.attacks}
    return attacks.get(dh.fuzzy_match(name, attacks.keys()))

args = &ARGS&
if not args: 
    return f'help {ctx.alias} -here'

c=character() 

weapon = find_attack(c, args[0])
if not weapon:
    return f"echo Weapon `{args[0]}` is not listed on {c.name}'s sheet.\n{character().attacks}"
atk = dh.parse_attack(weapon)
damage_dice = atk.get('damage')
attack_bonus = atk.get('bonus')
if attack_bonus is None or damage_dice is None:
    return f'echo Action {arg[0]} is not a weapon attack.'

args = args[1:]

summation = dh.parse(args)
sheet = dh.sheet()
duality_dice = dh.duality(sheet, summation)
duality_dice['bonus'] = [f'{attack_bonus}[{weapon.name}]'] +  duality_dice.get('bonus',[])
duality_roll = dh.roll_em(**duality_dice)

total, quality, goals = dh.interpret(**duality_roll)
damage = dh.damage_targets(goals, dh.proficiency(c), damage_dice)   # TODO get proficiency

effects=[]
if feature := atk.get('feature'):
    effects.append(f'**{weapon.name}:** {feature}')
if quality=='hope':
    effects.append(f'**Hope:** {dh.hope(+1)}')
elif quality=='critical':
    effects.append(f'**Hope:** {dh.hope(+1)}')
    effects.append(f'**Stress:** {dh.stress(-1)}')

hope = duality_roll.get('hope')
fear = duality_roll.get('fear')
bonus = duality_roll.get('bonus')

duality_desc = f'{hope.dice} + {fear.dice}'
result_desc = f'**{total}** *with {quality.capitalize()}*'

nl='\n'
if damage:
    result_desc += nl + dh.format_damage(damage)

effect_desc = nl + dh.format_effects(effects) if effects else ""

if bonus_desc := dh.format_bonus(bonus):
    return f'echo {duality_desc} {bonus_desc}: {result_desc}{effect_desc}'
else:
    return f'echo {duality_desc}: {result_desc}{effect_desc}'

</drac2>