<drac2> 
using(dh="c4092bda-44f7-4384-a10c-3f74f02092b8")

args=&ARGS&
if not args:
    return f'help {ctx.alias} -here'

feats = dh.load_feats()
C=character()

feat_name = args[0]
args=args[1:]

if feat:=feats.get(feat_name.lower()):
    pass
else:
    if feat_name:=dh.fuzzy_match(feat_name, feats.keys()):
        feat = feats.get(feat_name)
    else:
        return f'echo Unknown feature: `{args[0]}`' 

nl='\n'

lines=[]
if feat.get('category')=='domain':
    lines.append(f"**Level {feat.get('level')} {feat.get('domain','').capitalize()} {feat.get('type','').capitalize()}**")
else:
    assignment_keys='community','ancestry','subclass','class' 
    assignment=[]
    if level:=feat.get('level'):
        assignment.append(f"Level: {level}")
    if mastery:=feat.get('mastery'):
        assignment.append(dh.describe_mastery(mastery).capitalize())
    assignment+= [v.capitalize() for k,v in feat.items() if k in assignment_keys]
    lines.append(f"** {' '.join(assignment)} {feat.get('type', '')}**")

cost_keys='recall', 'hope', 'stress', 'armor'
# TODO for sub feats combine main feat costs and sub feat costs 
if costs:={k:v for k,v in feat.items() if k in cost_keys and v < 0}:
    lines.append(' '.join(f"**{k.capitalize()} cost: {-v}**" for k,v in costs.items()))

allowed = dh.is_allowed(feat_name, feat, C)
if allowed is not True: 
    lines.append(f"**Requires:** {', '.join(a.capitalize() for a in allowed.values())}")

#description 
lines.append(feat.get('description',''))

# execute 
# TODO, 
# 1 prevent if not available (with override 'allow')
# 2 deduct cost (with override 'free')
# 3 roll (with bonuses)

if source:=feat.get('source'):
    footer = f""" -footer "Source: {source}" """
else:
    footer = f""" -footer "Source: Unknown" """

if img:=feat.get('thumb'):
    thumb = f""" -thumb {img}"""
else:
    thumb = ""

return f"""embed -title "{feat_name.title()}" -desc "{nl.join(lines)}"{footer}{thumb}"""

</drac2>