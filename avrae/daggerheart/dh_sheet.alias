<drac2>
C=character()
using(dh="c4092bda-44f7-4384-a10c-3f74f02092b8")
S=dh.sheet(C) or dict()

name = C.name
img = C.image or dh.logo 

lines = []
fields = dict()

community, ancestry = dh.get_heritage(C)

lines.append(f'**Heritage:** {community.capitalize()} {ancestry.capitalize()}')

lines.append(f"**Pronouns:** {' / '.join(dh.pronouns().values())}")

lvl = C.levels.total_level
lines.append(f"**Level:** {lvl}")

classes = dh.get_class(C)
if classes:
    class_desc = ' / '.join(f"{dh.format_mastery(mastery).capitalize()} {sub.capitalize()} {cls.capitalize()}" for sub, cls, mastery in classes)
    lines.append(f"**Class:** {class_desc}")
else:
    lines.append("**Class:** set in Additional sheet at C69, multiclass in C70")

lines.append(f"**Agility:** {dh.agility(C)} **Strength:** {dh.strength(C)} **Finesse:** {dh.finesse(C)}")
lines.append(f"**Instinct:** {dh.instinct(C)} **Presence:** {dh.presence(C)} **Knowledge:** {dh.knowledge(C)}")


lines.append(f"**Evasion:** {C.ac}")

threshold_names=('Major','Severe','Massive','Deadly')
threshold = dh.thresholds()[2:]
lines.append("**Thresholds:** Minor (1) "+' '.join(f"**[**` {threshold} `**>** {threshold_names[idx]} ({idx+2})" for idx, threshold in enumerate(threshold)))

if experiences := dh.experiences(S, C):
    lines.append(f"**Experience:** {', '.join(f'{exp}: `{score}`' for exp, score in experiences.items())}")

lines.append(f'**Weapons:**')
for weapon in dh.weapons(C):
    # TODO Only way to weapon.get('range') seems to be from a gvar and avrae gsheet forces attack to be an integer, while !attack add, can support strings for traits
    lines.append(f"**{weapon.get('name')}** Bonus: `{weapon.get('bonus')}` Damage:`{weapon.get('damage')}` " + weapon.get('feature',''))


all_features =  dh.load_cards()
features=dh.heritage_features(community, ancestry, all_features)
for cls in classes:
    features += dh.class_features(*cls, all_features)
if features:
    lines.append(f"**Features:** {', '.join(feat.capitalize() for feat in features)}")

class_info = dh.load_classes()
if domains:=dh.all_domains(class_info, [cls[1] for cls in classes]):
    lines.append(f"**Domains:** {', '.join(domain.capitalize() for domain in domains)}")

lines.append(f"**Loadout:** {', '.join(dh.loadout(C))}")

lines.append(f"**Vault:** {', '.join(dh.vault(C))}")

fields['HP'] = dh.format_hp(C)
fields['Stress'] = dh.stress()[0][1]
fields['Hope'] = dh.hope()
fields['Armor'] = dh.armor()
fields['Gold'] = dh.gold().get('total')

fieldstr = ' '.join(f'-f "{title}|{desc}|inline"' for title,desc in fields.items())

nl='\n'
desc = nl.join(lines)
return f"""embed -title "{name}" -desc "{desc}" -thumb "{img}" {fieldstr} """
</drac2>