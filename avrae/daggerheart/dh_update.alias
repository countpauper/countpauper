<drac2>
using(dh="c4092bda-44f7-4384-a10c-3f74f02092b8")
argstr="""&*&"""
args=argparse(argstr,parse_ephem=False)
C=character()
sheet = dh.sheet(C) or dict()
hope=6
stress=dh.max_stress(C)
armor=dh.max_armor(C)

cc_updates=[]
cc_updates.append(dh.update_cc(C, 'Hope', 6))
cc_updates.append(dh.update_cc(C, 'Stress', stress))
cc_updates.append(dh.update_cc(C, 'Armor', armor))

def format_delta(d):
    if d<0:
        return str(d)
    else:
        return f'+{d}'

updates=list()
for cc_update in cc_updates:
    if cc_update[1] is None:
        updates.append(f'**{cc_update[0].name}:** {cc_update[0]} created.')
    elif cc_update[1]!=0:
        updates.append(f'**{cc_update[0].name}:** {cc_update[0]} `{format_delta(cc_update[1])}`.')

experiences = dh.experiences(sheet, C)
for new_experience in args.get('exp'):
    exp_update = dh.add_experience(sheet, new_experience, C)
    if typeof(exp_update[1])=="str":
        updates.append(f'**{exp_update[0]}** failed: {exp_update[1]}')
    else:
        updates.append(f'**{exp_update[0]}** (new) `{exp_update[1]}`')

for n in dh.experience_nrs:
    for changed_experience in args.get(f'exp{n}'):
        exp_update = dh.change_experience(sheet, n-min(dh.experience_nrs), changed_experience, C)
        if typeof(exp_update[1])=="str":
            updates.append(f'**{exp_update[0]}** failed: {exp_update[1]}')
        else:
            updates.append(f'**{exp_update[0]}** (redefined) `{exp_update[1]}`')
 
dh.save(sheet, C)

if not updates:
    return 'echo Everything is already up to date.'
else:
    nl='\n'
    return f"echo "**Updated sheet of {C.name}:**:\n{nl.join(str(u) for u in updates)}"
</drac2>