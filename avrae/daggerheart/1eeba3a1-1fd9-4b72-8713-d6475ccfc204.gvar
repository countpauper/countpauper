		"category": "subclass",
		"mastery": 1,
		"class": "assassin",
		"subclass": "executioner's guild",
		"type": "feature",
		"source": "SRD"
	},
	"scorpion's poise": {
		"description": "You gain a +2 bonus to your Evasion against attacks made by a creature you've Marked for Death.",
		"category": "subclass",
		"mastery": 2,
		"class": "assassin",
		"subclass": "executioner's guild",
		"type": "feature",
		"source": "SRD"
	},
	"backstab": {
		"description": "Your \u201cMarked for Death\u201d feature uses d8s instead of d6s.",
		"category": "subclass",
		"mastery": 3,
		"class": "assassin",
		"subclass": "executioner's guild",
		"type": "feature",
		"source": "SRD"
	},
	"toxic concoctions": {
		"description": "Mark a Stress to place 1d4+1 tokens on this card. When you make a successful weapon attack, you can spend a token to afflict the target with a poison. You know these poisons:\n\u25e6 Ghost Petal: The target becomes temporarily Vulnerable.\n\u25e6 Grave Spore: The target must also mark a Stress.\n\u25e6 Leech Weed: You deal an extra 1d6 damage on this attack.\nWhen you take a long rest, clear all unspent tokens",
		"category": "subclass",
		"mastery": 1,
		"class": "assassin",
		"subclass": "poisoner's guild",
		"type": "feature",
		"source": "SRD"
	},
	"poison compendium": {
		"description": "You also know these poisons:\n\u25e6 Midnight Vine: The target has disadvantage on attack rolls until it marks a Stress to clear this condition.\n\u25e6 Gorgon Root: The target becomes temporarily Restrained.",
		"category": "subclass",
		"mastery": 2,
		"class": "assassin",
		"subclass": "poisoner's guild",
		"type": "feature",
		"source": "SRD"
	},
	"venomancer": {
		"description": "You also know these poisons:\n\u25e6 Blight Seed: The target gains a \u22123 penalty to their damage thresholds until the end of the scene. This effect can\u2019t stack.\n\u25e6 Fear Leaf: You deal extra damage equal to the result of your Fear Die on this attack.\n\u25e6 Corpse Thorn: The target gains disadvantage on reaction rolls until the end of the scene.",
		"category": "subclass",
		"mastery": 3,
		"class": "assassin",
		"subclass": "poisoner's guild",
		"type": "feature",
		"source": "SRD"
	},
	"twin fang": {
		"description": "When you afflict a target Marked for Death with a poison you know, you can spend an additional token to also inflict the effect of a second poison you know.",
		"category": "subclass",
		"mastery": 2,
		"class": "assassin",
		"subclass": "poisoner's guild",
		"type": "feature",
		"source": "SRD"
	},
	"adder's blessing": {
		"description": "You are immune to poisons and other\nToxins.",
		"category": "subclass",
		"mastery": 3,
		"class": "assassin",
		"subclass": "poisoner's guild",
		"type": "feature",
		"source": "SRD"
	},
	"gifted performer": {
		"description": "Describe how you perform for others. You can play each song once per long rest:\n\u25e6 RELAXING SONG: You and all allies within Close range clear a Hit Point.\n\u25e6 EPIC SONG: Make a target within Close range temporarily Vulnerable.\n\u25e6 HEARTBREAKING SONG: You and all allies within Close range gain a Hope.",
		"category": "subclass",
		"mastery": 1,
		"class": "bard",
		"subclass": "troubadour",
		"type": "feature",
		"source": "SRD"
	},
	"maestro": {
		"description": "Your rallying songs steel the courage of those who listen. When you give a Rally Die to an ally, they can gain a Hope or clear a Stress.",
		"category": "subclass",
		"mastery": 2,
		"class": "bard",
		"subclass": "troubadour",
		"type": "feature",
		"source": "SRD"
	},
	"virtuoso": {
		"description": "You are among the greatest of your craft and your skill is boundless. You can perform each of your \\\"Gifted Performer\\\" feature's songs twice instead of once per long rest.",
		"category": "subclass",
		"mastery": 3,
		"class": "bard",
		"subclass": "troubadour",
		"type": "feature",
		"source": "SRD"
	},
	"rousing speech": {
		"description": "Once per long rest, you can give a heartfelt, inspiring speech. All allies within Far range clear 2 Stress.",
		"category": "subclass",
		"mastery": 1,
		"class": "bard",
		"subclass": "wordsmith",
		"type": "feature",
		"source": "SRD"
	},
	"heart of a poet": {
		"description": "After you make an action roll to impress, persuade or offend someone, you can spend a Hope to add a d4 to the roll.",
		"category": "subclass",
		"mastery": 1,
		"class": "bard",
		"subclass": "wordsmith",
		"type": "feature",
		"source": "SRD"
	},
	"eloquent": {
		"description": "Your moving words boost morale. Once per session, when you encourage an ally, you can do one of the following:\n\u25e6 Allow them to find a mundane object or tool they need.\n\u25e6 Help an Ally without spending Hope.\n\u25e6 Give them an additional downtime move during their next rest.",
		"category": "subclass",
		"mastery": 2,
		"class": "bard",
		"subclass": "wordsmith",
		"type": "feature",
		"source": "SRD"
	},
	"epic poetry": {
		"description": "Your Rally Die increases to a d10. Additionally, when you Help an Ally, you can narrate the moment as if you were writing the tale of their heroism in a memoir. When you do, roll a d10 as your advantage die.",
		"category": "subclass",
		"mastery": 3,
		"class": "bard",
		"subclass": "wordsmith",
		"type": "feature",
		"source": "SRD"
	},
	"rugged": {
		"description": "Gain a permanent +3 bonus to your Severe damage threshold.",
		"category": "subclass",
		"mastery": 1,
		"class": "brawler",
		"subclass": "juggernaut",
		"type": "feature",
		"source": "SRD"
	},
	"surrounded": {
		"description": "When you make an attack with a Melee weapon, you can spend any number of Hope to target an equal number of additional creatures within Melee range.",
		"category": "subclass",
		"mastery": 2,
		"class": "brawler",
		"subclass": "juggernaut",
		"type": "feature",
		"source": "SRD"
	},
	"pummeljoy": {
		"description": "When you critically succeed on a Melee weapon attack, you gain an additional Hope, clear an additional Stress, and gain a +1 bonus to your Proficiency for that attack.",
		"category": "subclass",
		"mastery": 3,
		"class": "brawler",
		"subclass": "juggernaut",
		"type": "feature",
		"source": "SRD"
	},
	"overwhelm": {
		"description": "When you succeed on an attack against a target, you can spend a Hope to throw the target within Close range or to force them to mark a Stress.",
		"category": "subclass",
		"mastery": 1,
		"class": "brawler",
		"subclass": "juggernaut",
		"type": "feature",
		"source": "SRD"
	},
	"eye for an eye": {
		"description": "Once per rest when an adversary within Melee range forces you to mark any number of Hit Points, you can mark a Stress to force them to mark the same number of Hit Points.",
		"category": "subclass",
		"mastery": 2,
		"class": "brawler",
		"subclass": "juggernaut",
		"type": "feature",
		"source": "SRD"
	},
	"not done yet": {
		"description": "When you take Severe damage, you can gain a Hope or clear a Stress.",
		"category": "subclass",
		"mastery": 3,
		"class": "brawler",
		"subclass": "juggernaut",
		"type": "feature",
		"source": "SRD"
	},
	"stance fighter": {
		"description": "You can channel your inner resolve to shift into martial stances that grant you special benefits in combat.\nTake the Martial Stances sheet and choose two martial stances from Tier 1. Each time you level up your character, choose an additional stance from your tier or lower.",
		"category": "subclass",
		"mastery": 1,
		"class": "brawler",
		"subclass": "martial artist",
		"type": "feature",
		"source": "SRD"
	},
	"keen defenses": {
		"description": "When you\u2019re targeted by an attack, you can spend a Focus to gain a bonus to your Evasion equal to your tier against the attack.",
		"category": "subclass",
		"mastery": 2,
		"class": "brawler",
		"subclass": "martial artist",
		"type": "feature",
		"source": "SRD"
	},
	"limit breaker": {
		"description": "Once per rest, you can perform an unbelievable feat of athletic prowess, such as running across water, leaping between distant rooftops, or scaling a building without needing to roll. When you do, gain a Hope and clear a Stress.",
		"category": "subclass",
		"mastery": 3,
		"class": "brawler",
		"subclass": "martial artist",
		"type": "feature",
		"source": "SRD"
	},
	"focus cannon": {
		"description": "Spend a Focus to make an Instinct Roll against an adversary within Far range. On a success, deal d20+3 magic damage using your Proficiency.",
		"category": "subclass",
		"mastery": 2,
		"class": "brawler",
		"subclass": "martial artist",
		"type": "feature",
		"source": "SRD"
	},
	"flow state": {
		"description": "You can mark a Stress instead of spending a Focus to shift into a different stance. Additionally, you can spend a Focus instead of marking a Stress to start a combo strike.",
		"category": "subclass",
		"mastery": 3,
		"class": "brawler",
		"subclass": "martial artist",
		"type": "feature",
		"source": "SRD"
	},
	"elemental incarnation": {
		"description": "Mark a Stress to Channel one of the following elements until you take Severe damage or until your next rest:\n\u25e6 FIRE: When an adversary within Melee range deals damage to you, they take 1d10 magic damage.\n\u25e6 EARTH: Gain a bonus to your damage thresholds equal to your Proficiency.\n\u25e6 WATER: When you deal damage to an adversary within Melee range, all other adversaries within Very Close range must mark a Stress.\n\u25e6 AIR: You can hover, gaining advantage on Agility Rolls.",
		"category": "subclass",
		"mastery": 1,
		"class": "druid",
		"subclass": "way of the elements",
		"type": "feature",
		"source": "SRD"
	},
	"elemental aura": {
		"description": "Once per rest while Channeling, you can assume an aura matching your element. The aura affects targets within Close ragne until your Channeling ends.\n\u25e6 FIRE: When an adversary marks 1 or more Hit Points, they must also mark a Stress.\n\u25e6 EARTH: Your allies gain a +1 bonus to Strength.\n\u25e6 WATER: When an adversary deals damage to you, you can mark a Stress to move them anywhere within Very Close range of where they are.\n\u25e6 AIR: When you or an ally takes damage from an attack beyond Melee range, reduce the damage by 1d8.",
		"category": "subclass",
		"mastery": 2,
		"class": "druid",
		"subclass": "way of the elements",
		"type": "feature",
		"source": "SRD"
	},
	"elemental dominion": {
		"description": "You further embody your element. while Channeling, you gain the following benefit:\n\u25e6 FIRE: You gain a +1 bonus to your Proficiency for attacks and spells that deal damage.\n\u25e6 EARTH: When you would mark Hit Points, roll a d6 per Hit Point marked. For each result of 6, reduce the number of Hit Points you mark by 1.\n\u25e6 WATER: When an attack against you succeeds, you can mark a Stress to make the attacker temporarily Vulnerable.\n\u25e6 AIR: You gain a +1 bonus to your Evasion and can fly.",
		"category": "subclass",
		"mastery": 3,
		"class": "druid",
		"subclass": "way of the elements",
		"type": "feature",
		"source": "SRD"
	},
	"regeneration": {
		"description": "Touch a create and spend 3 Hope. That creature clears 1d4 Hit Points.",
		"category": "subclass",
		"mastery": 1,
		"class": "druid",
		"subclass": "way of renewal",
		"type": "feature",
		"source": "SRD"
	},
	"regenerative reach": {
		"description": "You can target creatures within Very Close range with your \\\"Regeneration\\\" feature.",
		"category": "subclass",
		"mastery": 2,
		"class": "druid",
		"subclass": "way of renewal",
		"type": "feature",
		"source": "SRD"
	},
	"defender": {
		"description": "Your animal transformation embodies a healing guardian spirit. When you're in Beastform and an ally within Close range marks 2 or more Hit Points, you can mark a Stress to reduce the number of Hit Points they mark by 1.",
		"category": "subclass",
		"mastery": 3,
		"class": "druid",
		"subclass": "way of renewal",
		"type": "feature",
		"source": "SRD"
	},
	"warden's protection": {
		"description": "Once per long rest, spend 2 Hope to clear 2 Hit Points on 1d4 allies within Close range.",
		"category": "subclass",
		"mastery": 2,
		"class": "druid",
		"subclass": "way of renewal",
		"type": "feature",
		"source": "SRD"
	},
	"unwavering": {
		"description": "Gain a permanent +1 bonus to your damage thresholds.",
		"category": "subclass",
		"mastery": 1,
		"class": "guardian",
		"subclass": "stalwart",
		"type": "feature",
		"source": "SRD"
	},
	"unrelenting": {
		"description": "Gain a permanent +2 bonus to your damage thresholds.",
		"category": "subclass",
		"mastery": 2,
		"class": "guardian",
		"subclass": "stalwart",
		"type": "feature",
		"source": "SRD"
	},
	"undaunted": {
		"description": "Gain a permanent +3 bonus to your damage thresholds.",
		"category": "subclass",
		"mastery": 3,
		"class": "guardian",
		"subclass": "stalwart",
		"type": "feature",
		"source": "SRD"
	},
	"iron will": {
		"description": "When you take physical damage, you can mark an additional Armor Slot to reduce the severity.",
		"category": "subclass",
		"mastery": 1,
		"class": "guardian",
		"subclass": "stalwart",
		"type": "feature",
		"source": "SRD"
	},
	"partners-in-arms": {
		"description": "When an ally within Very Close range takes damage, you can mark an Armor Slot to reduce the severity by one threshold.",
		"category": "subclass",
		"mastery": 2,
		"class": "guardian",
		"subclass": "stalwart",
		"type": "feature",
		"source": "SRD"
	},
	"loyal protector": {
		"description": "When an ally within Close range has 2 or fewer Hit Points and would take damage, you can mark a Stress to sprint to their side and take the damage instead.",
		"category": "subclass",
		"mastery": 3,
		"class": "guardian",
		"subclass": "stalwart",
		"type": "feature",
		"source": "SRD"
	},
	"at ease": {
		"description": "Gain an additional Stress slot.",
		"category": "subclass",
		"mastery": 1,
		"class": "guardian",
		"subclass": "vengeance",
		"type": "feature",
		"source": "SRD"
	},
	"act of reprisal": {
		"description": "When an adversary damages an ally within Melee range, you gain a +1 bonus to your Proficiency for the next successful attack you make against that adversary.",
		"category": "subclass",
		"mastery": 2,
		"class": "guardian",
		"subclass": "vengeance",
		"type": "feature",
		"source": "SRD"
	},
	"nemesis": {
		"description": "Spend 2 Hope to Priortize an adversary until your next rest. When you make an attack against your Prioritized adversary, you can swap the results of your Hope and Fear Dice. You can only Prioritize one adversary at a time.",
		"category": "subclass",
		"mastery": 3,
		"class": "guardian",
		"subclass": "vengeance",
		"type": "feature",
		"source": "SRD"
	},
	"revenge": {
		"description": "When an adversary within Melee range succeeds on an attack against you, you can mark 2 Stress to force the attacker to mark a Hit Point.",
		"category": "subclass",
		"mastery": 1,
		"class": "guardian",
		"subclass": "vengeance",
		"type": "feature",
		"source": "SRD"
	},
	"companion": {
		"description": "You have an animal companion of your choice (at the GM's discretion). They stay by your side unless you tell them otherwise.\nTake the Ranger Companion sheet. When you level up your character, choose a level-up option for your companion from this sheet as well.",
		"category": "subclass",
		"mastery": 1,
		"class": "ranger",
		"subclass": "beastbound",
		"type": "feature",
		"source": "SRD"
	},
	"expert training": {
		"description": "Choose an additional level-up option for your companion.",
		"category": "subclass",
		"mastery": 2,
		"class": "ranger",
		"subclass": "beastbound",
		"type": "feature",
		"source": "SRD"
	},
	"advanced training": {
		"description": "Choose two additional level-up options for your companion",
		"category": "subclass",
		"mastery": 3,
		"class": "ranger",
		"subclass": "beastbound",
		"type": "feature",
		"source": "SRD"
	},
	"battle-bonded": {
		"description": "When an adversary attacks you while they're within your companion's Melee range, you gain a +2 bonus to your Evasion against the attack.",
		"category": "subclass",
		"mastery": 2,
		"class": "ranger",
		"subclass": "beastbound",
		"type": "feature",
		"source": "SRD"
	},
	"loyal friend": {
		"description": "Once per long rest, when the damage from ana ttack would mark your companion's last Stress or your last Hit Point and you're within Close range of each other, you or your companion can rush to the other's side and take that damage instead.",
		"category": "subclass",
		"mastery": 3,
		"class": "ranger",
		"subclass": "beastbound",
		"type": "feature",
		"source": "SRD"
	},
	"ruthless predator": {
		"description": "When you make a damage roll, you can mark a Stress to gain a +1 bonus to your Proficiency. Additionally, when you deal Severe damage to an adversary, they must mark a Stress.\nPATH FORWARD: When you're traveling to a place you've previously visitedor you carry an object that has been at the location before, you can identify the shortest, most direct path to your destination.",
		"category": "subclass",
		"mastery": 1,
		"class": "ranger",
		"subclass": "wayfinder",
		"type": "feature",
		"source": "SRD"
	},
	"elusive predator": {
		"description": "When your Focus makes an attack against you, you gain a +2 bonus to your Evasion against the attack.",
		"category": "subclass",
		"mastery": 2,
		"class": "ranger",
		"subclass": "wayfinder",
		"type": "feature",
		"source": "SRD"
	},
	"apex predator": {
		"description": "Before you make an attack roll against your Focus, you can spend a Hope. On a successful attack, you remove a Fear from the GM's Fear pool.",
		"category": "subclass",
		"mastery": 3,
		"class": "ranger",
		"subclass": "wayfinder",
		"type": "feature",
		"source": "SRD"
	},
	"shadow stepper": {
		"description": "You can move from shadow to shadow. When you move into an area of darkness or a shadow cast by another creature or object, you can mark a Stress to disappear from where you are and reappear inside another shadow within Far range. When you reappear, you are Cloaked.",
		"category": "subclass",
		"mastery": 1,
		"class": "rogue",
		"subclass": "night walker",
		"type": "feature",
		"source": "SRD"
	},
	"dark cloud": {
		"description": "Make a Spellcast Roll (15). On a success, create a temporary dark cloud that covers any area within Close range. Anyone in this cloud can't see outside of it, and anyone outside of it can't see in. You're considered Cloaked from any adversary for whom the cloud blocks line of sight.\nADRENALINE: While you're Vulnerable, add your level to your damage rolls.",
		"category": "subclass",
		"mastery": 2,
		"class": "rogue",
		"subclass": "night walker",
		"type": "feature",
		"source": "SRD"
	},
	"fleeting shadow": {
		"description": "Gain a permanent +1 bonus to your Evasion. You can use your \\\"Shadow Stepper\\\" feature to move within Very Far range.",
		"category": "subclass",
		"mastery": 3,
		"class": "rogue",
		"subclass": "night walker",
		"type": "feature",
		"source": "SRD"
	},
	"vanishing act": {
		"description": "Mark a Stress to become Cloaked at any time. When Cloaked from this feature, you automatically clear the Restrained condition if you have it. You remain Cloaked in this way until you roll with Fear or until your next rest.",
		"category": "subclass",
		"mastery": 3,
		"class": "rogue",
		"subclass": "night walker",
		"type": "feature",
		"source": "SRD"
	},
	"well-connected": {
		"description": "When you arrive in a prominent town or environment, you know somebody who calls this place home. Give them a name, note how you think they could be useful, and choose one fact from the following list:\n\u25e6 They owe me a favor, but they'll be hard to find.\n\u25e6 They're going to ask for something in exchange.\n\u25e6 They're always in a great deal of trouble.\n\u25e6 We used to be together. It's a long story.\n\u25e6 We didn't part on great terms.",
		"category": "subclass",
		"mastery": 1,
		"class": "rogue",
		"subclass": "syndicate",
		"type": "feature",
		"source": "SRD"
	},
	"contacts everywhere": {
		"description": "Once per session, you can briefly call on a shady contact. Choose one of the following benefits and describe what brought them here to help you in this moment:\n\u25e6 They provide 1 handful of gold, a unique tool, or a mundane object that the situation requires.\n\u25e6 On your next action roll, their help provides a +3 bonus to the result of your Hope or Fear Die.\n\u25e6 The next time you deal damage, they snipe from the shadows, adding 2d8 to your damage rolls.",
		"category": "subclass",
		"mastery": 2,
		"class": "rogue",
		"subclass": "syndicate",
		"type": "feature",
		"source": "SRD"
	},
	"reliable backup": {
		"description": "You can use your \\\"Contacts Everywhere\\\" feature three times per session. The following options are added to the list of benefits you can choose from when you use that feature:\n\u25e6 When you mark 1 or more Hit Points, they can rush out to shield you, reducing Hit Points marked by 1.\n\u25e6 When you make a Presence Roll in conversation, they back you up. You can roll a d20 as your Hope Die.",
		"category": "subclass",
		"mastery": 3,
		"class": "rogue",
		"subclass": "syndicate",
		"type": "feature",
		"source": "SRD"
	},
	"sparing touch": {
		"description": "Once per long rest, touch a creature and clear 2 Hit Points or 2 Stress from them.",
		"category": "subclass",
		"mastery": 1,
		"class": "seraph",
		"subclass": "divine wielder",
		"type": "feature",
		"source": "SRD"
	},
	"devout": {
		"description": "When you roll your Prayer Dice, you can roll an additional die and discard the lowest result. Additionally, you can use your \\\"Sparing Touch\\\" feature twice instead of once per long rest.",
		"category": "subclass",
		"mastery": 2,
		"class": "seraph",
		"subclass": "divine wielder",
		"type": "feature",
		"source": "SRD"
	},
	"sacred resonance": {
		"description": "When you roll damage for your \\\"Spirit Weapon\\\" feature, if any of the die results match, double the value of each matching die. For example, if you roll two 5s, they count as two 10s.",
		"category": "subclass",
		"mastery": 3,
		"class": "seraph",
		"subclass": "divine wielder",
		"type": "feature",
		"source": "SRD"
	},
	"spirit weapon": {
		"description": "When you have an equipped weapon with a range of Melee or Very Close, it can fly from your hand to attack an adversary within Close range and then return to you. You can mark a Stress to target an additional adversary within range with the same attack roll.",
		"category": "subclass",
		"mastery": 1,
		"class": "seraph",
		"subclass": "divine wielder",
		"type": "feature",
		"source": "SRD"
	},
	"wings of light": {
		"description": "You can fly. While flying, you can do the following:\n\u25e6 Mark a Stress to pick up and carry another willing creature approximately your size or smaller.\n\u25e6 Spend a Hope to deal an extra 1d8 damage on a successful attack.",
		"category": "subclass",
		"mastery": 1,
		"class": "seraph",
		"subclass": "winged sentinel",
		"type": "feature",
		"source": "SRD"
	},
	"ethereal visage": {
		"description": "Your supernatural visage strikes awe and fear. While flying, you have advantage on Presence Rolls. When you succeed with Hope on a Presence Roll, you can remove a Fear from the GM's Fear pool instead of gaining Hope.",
		"category": "subclass",
		"mastery": 2,
		"class": "seraph",
		"subclass": "winged sentinel",
		"type": "feature",
		"source": "SRD"
	},
	"ascendant": {
		"description": "Gain a permanent +4 bonus to your Severe damage threshold.",
		"category": "subclass",
		"mastery": 3,
		"class": "seraph",
		"subclass": "winged sentinel",
		"type": "feature",
		"source": "SRD"
	},
	"power of the gods": {
		"description": "While flying, you deal an extra 1d12 damage instead of 1d8 from your \\\"Wings of Light\\\" feature.",
		"category": "subclass",
		"mastery": 3,
		"class": "seraph",
		"subclass": "winged sentinel",
		"type": "feature",
		"source": "SRD"
	},
	"elementalist": {
		"description": "Choose one of the following elements at character creation: air, earth, fire, lightning, water.\nYou can shape this element into harmless effects. Additionally, spend a Hope and describe how your control over this element helps an action roll you're about to make, then either gain a +2 bonus to the roll or a +3 bonus to the roll's damage.",
		"category": "subclass",
		"mastery": 1,
		"class": "sorcerer",
		"subclass": "elemental origin",
		"type": "feature",
		"source": "SRD"
	},
	"natural evasion": {
		"description": "You can call forth your element to protect you from harm. When an attack roll against you succeeds, you can mark a Stress and describe how you use your element to defend you. When you do, rol a d6 and add its result to your Evasion against the attack.",
		"category": "subclass",
		"mastery": 2,
		"class": "sorcerer",
		"subclass": "elemental origin",
		"type": "feature",
		"source": "SRD"
	},
	"transcendence": {
		"description": "Once per long rest, you can transform into a physical manifestation of your element. When you do, describe your transformation and choose two of the following benefits to gain until your next rest:\n\u25e6 +4 bonus to your Severe threshold\n\u25e6 +1 bonus to a character trait of your choice\n\u25e6 +1 bonus to your Proficiency\n\u25e6 +2 bonus to your Evasion",
		"category": "subclass",
		"mastery": 3,
		"class": "sorcerer",
		"subclass": "elemental origin",
		"type": "feature",
		"source": "SRD"
	},
	"manipulate magic": {
		"description": "Your primal origin allows you to modify the essence of magic itself. After you cast a spell or make an attack using a weapon that deals magic damage, you can mark a Stress to do one of the following:\n\u25e6 Extend the spell or attack's reach by one range\n\u25e6 Gain a +2 bonus to the action roll's result\n\u25e6 Double a damage die of your choice\n\u25e6 Hit an additional target within range",
		"category": "subclass",
		"mastery": 1,
		"class": "sorcerer",
		"subclass": "primal origin",
		"type": "feature",
		"source": "SRD"
	},
	"enchanted aid": {
		"description": "You can enhance the magic of others with your essence. When you Help an Ally with a Spellcast Roll, you can roll a d8 as your advantage die. Once per long rest, after an ally has made a Spellcast Roll with your help, you can swap the results of their Duality Dice.",
		"category": "subclass",
		"mastery": 2,
		"class": "sorcerer",
		"subclass": "primal origin",
		"type": "feature",
		"source": "SRD"
	},
	"arcane charge": {
		"description": "You can gather magical energy to enhance your capabilities. When you take magic damage, you become Charged. Alternatively, you can spend 2 Hope to become Charged. When you successfully make an attack that deals magic damage while Charged, you can clear your Charge to either gain a +10 bonus to the damage roll or gain a +3 bonus to the Difficulty of a reaction roll the spell causes the target to make. You stop being Charged at your next long rest.",
		"category": "subclass",
		"mastery": 3,
		"class": "sorcerer",
		"subclass": "primal origin",
		"type": "feature",
		"source": "SRD"
	},
	"patron's mantle": {
		"description": "Spend a Favor to cloak yourself in a terrifying aspect of your Patron that lasts until you take Severe damage or the scene ends. While this effect is active, you gain a bonus to your damage thresholds equal to your tier and have advantage on action rolls to intimidate a target.",
		"category": "subclass",
		"mastery": 1,
		"class": "warlock",
		"subclass": "pact of the endless",
		"type": "feature",
		"source": "SRD"
	},
	"harrowing invocation": {
		"description": "When an adversary targets you or an ally within Very Close range with an attack, you can spend a Favor to give them disadvantage on the roll. If the adversary fails the roll, they must also mark a Stress.",
		"category": "subclass",
		"mastery": 2,
		"class": "warlock",
		"subclass": "pact of the endless",
		"type": "feature",
		"source": "SRD"
	},
	"dark aegis": {
		"description": "Once per long rest when you would take damage, you can spend a Favor instead of marking Hit Points.",
		"category": "subclass",
		"mastery": 3,
		"class": "warlock",
		"subclass": "pact of the endless",
		"type": "feature",
		"source": "SRD"
	},
	"deathless embrace": {
		"description": "Once per rest, spend any number of Favor to roll an equal number of Patron Dice. For each result of 4 or higher, clear a Hit Point.",
		"category": "subclass",
		"mastery": 1,
		"class": "warlock",
		"subclass": "pact of the endless",
		"type": "feature",
		"source": "SRD"
	},
	"damage sink": {
		"description": "Once per rest, you can spend a Favor to halve incoming damage.",
		"category": "subclass",
		"mastery": 2,
		"class": "warlock",
		"subclass": "pact of the endless",
		"type": "feature",
		"source": "SRD"
	},
	"draining bane": {
		"description": "When an adversary targets you or an ally within Very Close range with an attack, you can spend a Favor to Drain them. When you do, they must mark a Stress, and you can clear a Stress. While Drained, the target uses a d12 instead of a d20 for attack rolls (including for advantage or disadvantage) until they fail a roll.",
		"category": "subclass",
		"mastery": 3,
		"class": "warlock",
		"subclass": "pact of the endless",
		"type": "feature",
		"source": "SRD"
	},
	"patron's fury": {
		"description": "Spend a Favor to imbue your attacks with your Patron\u2019s power until you deal Severe damage or the scene ends. When you roll damage while this effect is active, you also roll a number of Patron Dice equal to your tier and add their total to the damage dealt.",
		"category": "subclass",
		"mastery": 1,
		"class": "warlock",
		"subclass": "pact of the wrathful",
		"type": "feature",
		"source": "SRD"
	},
	"menacing reach": {
		"description": "Spend a Favor to increase the range of your primary weapon by one step (such as Melee to Very Close or Very Close to Close) to a maximum of Very Far range. This effect ends when you make a successful attack with that weapon.",
		"category": "subclass",
		"mastery": 2,
		"class": "warlock",
		"subclass": "pact of the wrathful",
		"type": "feature",
		"source": "SRD"
	},
	"fearsome attack": {
		"description": "Spend a Favor to reroll any number of your damage dice. You can continue spending Favor to use this feature on the same damage roll.",
		"category": "subclass",
		"mastery": 3,
		"class": "warlock",
		"subclass": "pact of the wrathful",
		"type": "feature",
		"source": "SRD"
	},
	"deadly vengeance": {
		"description": "When you mark any number of Hit Points from an attack, you can spend a Favor to roll an equal number of Patron Dice. For each result of 4 or higher, the attacker marks a Hit Point.",
		"category": "subclass",
		"mastery": 1,
		"class": "warlock",
		"subclass": "pact of the wrathful",
		"type": "feature",
		"source": "SRD"
	},
	"diminish my foes": {
		"description": "When you succeed with Hope on an action roll against a target, you can spend any number of Favor to force the target to mark an equal number of Stress",
		"category": "subclass",
		"mastery": 2,
		"class": "warlock",
		"subclass": "pact of the wrathful",
		"type": "feature",
		"source": "SRD"
	},
	"otherworldly ire": {
		"description": "Once per rest when you take damage, you can spend any number of Favor to roll that many Patron Dice and target a number of creatures within Close range equal to the highest result. Each target must mark a Hit Point.",
		"category": "subclass",
		"mastery": 3,
		"class": "warlock",
		"subclass": "pact of the wrathful",
		"type": "feature",
		"source": "SRD"
	},
	"courage": {
		"description": "When you fail a roll with Fear, you gain a Hope.",
		"category": "subclass",
		"mastery": 1,
		"class": "warrior",
		"subclass": "call of the brave",
		"type": "feature",
		"source": "SRD"
	},
	"rise to the challenge": {
		"description": "You are vigilant in the face of mounting danger. While you have 2 or fewer Hit Points unmarked, you can roll a d20 as your Hope Dice.",
		"category": "subclass",
		"mastery": 2,
		"class": "warrior",
		"subclass": "call of the brave",
		"type": "feature",
		"source": "SRD"
	},
	"camaraderie": {
		"description": "You unwavering bravery is a rallying point for your allies. You can initiate a Tag Team Roll one additional time per session. Additionally, when an ally initiates a Tag Team Roll with you, they only need to spend 2 Hope to do so.",
		"category": "subclass",
		"mastery": 3,
		"class": "warrior",
		"subclass": "call of the brave",
		"type": "feature",
		"source": "SRD"
	},
	"battle ritual": {
		"description": "Once per long rest, before you attempt something incredibly dangerous or face off against a foe who clearly outmatches you, describe what ritual you perform or preparations you make. When you do, clear 2 Stress and gain 2 Hope.",
		"category": "subclass",
		"mastery": 1,
		"class": "warrior",
		"subclass": "call of the brave",
		"type": "feature",
		"source": "SRD"
	},
	"slayer": {
		"description": "You gain a pool of dice called Slayer Dice. On a roll with Hope, you can place a d6 on this card instead of a Hope, adding the die to the pool. You can store a number of Slayer Dice equal to your Proficiency. When you make an attack roll or damage roll, you can spend any number of these Slayer Dice, rolling them and adding their result to the roll. At the end of each session, clear any unspent Slayer Dice on this card and gain a Hope per die cleared.",
		"category": "subclass",
		"mastery": 1,
		"class": "warrior",
		"subclass": "call of the slayer",
		"type": "feature",
		"source": "SRD"
	},
	"weapon specialist": {
		"description": "You can wield multiple weapons with dangerous ease. When you succeed on an attack, you can spend a Hope to add one of the damage dice from your secondary weapon to the damage roll. Additionally, once per long rest when you roll your Slayer Dice, reroll any 1s.",
		"category": "subclass",
		"mastery": 2,
		"class": "warrior",
		"subclass": "call of the slayer",
		"type": "feature",
		"source": "SRD"
	},
	"martial preparation": {
		"description": "You're an inspirational warrior to all who travel with you. Your party gains access to the martial Preparation downtime move. To use this move during a rest, describe how you instruct and train with your party. You and each ally who chooses this downtime gain a d6 Slayer Die. A PC with a Slayer Die can spend it to roll the die and add the result to an attack or damage roll of their choice.",
		"category": "subclass",
		"mastery": 3,
		"class": "warrior",
		"subclass": "call of the slayer",
		"type": "feature",
		"source": "SRD"
	},
	"herbal remedies": {
		"description": "When you or an ally in the scene clears 1 or more Hit Points or Stress as the result of using a consumable, increase the number cleared by 1.",
		"category": "subclass",
		"mastery": 1,
		"class": "witch",
		"subclass": "hedge",
		"type": "feature",
		"source": "SRD"
	},
	"walk between worlds": {
		"description": "During a moment of calm, make a Spellcast Roll (13). Once per rest on a success, you can mark a Stress to step beyond the veil of death and converse with any nearby spirits. Place a number of tokens equal to your Spellcast trait on this card and remove one each time a spirit answers a question. When the last token is removed or at the end of the scene, you return to the Mortal Realm in the same spot you left it",
		"category": "subclass",
		"mastery": 2,
		"class": "witch",
		"subclass": "hedge",
		"type": "feature",
		"source": "SRD"
	},
	"circle of power": {
		"description": "Once per rest, mark a circle on the ground outlining a Very Close area around you, and place a number of tokens equal to your Spellcast trait on this card. While within this circle, you and your allies gain a +2 bonus to damage thresholds, attack rolls, and Evasion. Remove a token each time you or an ally within the circle makes an action roll or evades an attack. This spell lasts until the last token is removed or you exit the circle.",
		"category": "subclass",
		"mastery": 3,
		"class": "witch",
		"subclass": "hedge",
		"type": "feature",
		"source": "SRD"
	},
	"enchanted talisman": {
		"description": "Once per rest, you can imbue a small item with your protective essence. Spend any number of Hope to place an equal number of tokens on this card.\nWhen the person holding the talisman takes damage, spend a token to reduce the number of Hit Points they mark by one. Clear all tokens from this card when you take a rest.",
		"category": "subclass",
		"mastery": 1,
		"class": "witch",
		"subclass": "hedge",
		"type": "feature",
		"source": "SRD"
	},
	"vexing malison": {
		"description": "You have advantage on attacks against Hexed creatures.",
		"category": "subclass",
		"mastery": 2,
		"class": "witch",
		"subclass": "hedge",
		"type": "feature",
		"source": "SRD"
	},
	"night's glamour": {
		"description": "Make a Spellcast Roll (13) to Glamour yourself in a bewitching facade. While Glamoured, you have advantage on rolls that leverage your illusory appearance. \nAdditionally, adversaries within Close range must mark a Stress to attack you. \nUnless you mark a Stress to maintain your Glamour, it drops when you mark a Hit Point or deal damage.",
		"category": "subclass",
		"mastery": 1,
		"class": "witch",
		"subclass": "moon",
		"type": "feature",
		"source": "SRD"
	},
	"moonbeam": {
		"description": "Once per session, you can conjure a column of moonlight that illuminates the area within Close range until the end of the scene. While bathed in this moonlight, you and your allies gain a +1 bonus to Spellcast Rolls and can see through illusions.",
		"category": "subclass",
		"mastery": 2,
		"class": "witch",
		"subclass": "moon",
		"type": "feature",
		"source": "SRD"
	},
	"lunar phases": {
		"description": "At the beginning of each session, roll a d6 and place it on this card. You gain the matching effect until the end of session.\n1 [New] : Spend a Hope to negate Minor damage.\n2-3 [Waxing] : +2 to damage rolls\n4 [Full] : +3 to damage thresholds\n5-6 [Waning] : +1 to Evasion\nOnce per rest, you can spend a Hope to increase the value of this die by one. If you increase the value of a 6, it becomes a 1.",
		"category": "subclass",
		"mastery": 3,
		"class": "witch",
		"subclass": "moon",
		"type": "feature",
		"source": "SRD"
	},
	"ire of pale light": {
		"description": "When a Hexed creature within Very Far range fails an attack, they must mark a Stress.",
		"category": "subclass",
		"mastery": 2,
		"class": "witch",
		"subclass": "moon",
		"type": "feature",
		"source": "SRD"
	},
