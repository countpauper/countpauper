	"nimble": {
		"description": "Gain a permanent +1 bonus to your Evasion at character creation.",
		"category": "ancestry",
		"type": "feature",
		"source": "SRD",
		"ancestry": "Simiah"
	},
	"oasis": {
		"description": "During a short rest, you or an ally can reroll a die used for a downtime move and take the higher result.",
		"category": "community",
		"type": "feature",
		"source": "SRD",
		"community": "Duneborne"
	},
	"unbound": {
		"description": "Once per session when you roll with Fear, you can change it into a roll with Hope instead.",
		"category": "community",
		"type": "feature",
		"source": "SRD",
		"community": "Freeborne"
	},
	"hardy": {
		"description": "When you take a rest, you clear a Hit Point.",
		"category": "community",
		"type": "feature",
		"source": "SRD",
		"community": "Frostborne"
	},
	"close-knit": {
		"description": "Once per long rest, you can spend any number of Hope to grant an ally within Far range an equal number of Hope",
		"category": "community",
		"type": "feature",
		"source": "SRD",
		"community": "Hearthborne"
	},
	"privilege": {
		"description": "You have advantage on rolls to consort with nobles, negotiate prices, or leverage your reputation to get what you want.",
		"category": "community",
		"type": "feature",
		"source": "SRD",
		"community": "Highborne"
	},
	"well-read": {
		"description": "You have advantage on rolls that invoke the history, culture, or politics of a prominent person or place.",
		"category": "community",
		"type": "feature",
		"source": "SRD",
		"community": "Loreborne"
	},
	"dedicated": {
		"description": "Record three sayings or values your upbringing instilled in you. Once per rest, when you describe how you're embodying one of these principles through your current action, you can roll a d20 as your Hope Die.",
		"category": "community",
		"type": "feature",
		"source": "SRD",
		"community": "Orderborne"
	},
	"found family": {
		"description": "Once per rest, you can spend a Hope to use an ally\u2019s Experience as if it were your own. When you do so,\ndescribe how your time with that ally prepared you for this moment.\nWhen you join a new community or rediscover your old one, you can permanently trade this card for that one instead.",
		"category": "community",
		"type": "feature",
		"source": "SRD",
		"community": "Reborne"
	},
	"steady": {
		"description": "You have advantage on rolls to traverse dangerous cliffs and ledges, navigate harsh environments, and use your survival knowledge.",
		"category": "community",
		"type": "feature",
		"source": "SRD",
		"community": "Ridgeborne"
	},
	"know the tide": {
		"description": "You can sense the ebb and flow of life. When you roll with Fear, place a token on your community card. You can hold a number of tokens equal to your level. Before you make an action roll, you can spend any number of these tokens to gain a +1 bonus to the roll for each token spent. At the end of each session, clear all unspent tokens.",
		"category": "community",
		"type": "feature",
		"source": "SRD",
		"community": "Seaborne"
	},
	"scoundrel": {
		"description": "You have advantage on rolls to negotiate with criminals, detect lies, or find a safe place to hide.",
		"category": "community",
		"type": "feature",
		"source": "SRD",
		"community": "Slyborne"
	},
	"low-light living": {
		"description": "When you're in an area with low light or heavy shadow, you have advantage on rolls to hide, investigate, or perceive details in that area.",
		"category": "community",
		"type": "feature",
		"source": "SRD",
		"community": "Underborne"
	},
	"nomadic pack": {
		"description": "Add a Nomadic Pack to your inventory. Once per session, you can spend a Hope to reach into this pack and pull out a mundane item that's useful to your situation. Work with the GM to figure out what item you take out.",
		"category": "community",
		"type": "feature",
		"source": "SRD",
		"community": "Wanderborne"
	},
	"brave face": {
		"description": "Once per session when you would be forced to mark a Stress, you can spend a Hope instead.",
		"category": "community",
		"type": "feature",
		"source": "SRD",
		"community": "Warborne"
	},
	"lightfoot": {
		"description": "Your movement is naturally silent. You have advantage on rolls to move without being heard.",
		"category": "community",
		"type": "feature",
		"source": "SRD",
		"community": "Wildborne"
	},
	"gifted": {
		"description": "You gain a +1 bonus to action, reaction, and damage Rolls.",
		"category": "transformation",
		"type": "feature",
		"source": "SRD",
		"transformation": "Demigod"
	},
	"weight of divinity": {
		"description": "When you fail a roll, you must mark a Stress or the GM gains a Fear.",
		"category": "transformation",
		"type": "feature",
		"source": "SRD",
		"transformation": "Demigod",
		"stress": -1
	},
	"unfinished business": {
		"description": "Work with your GM to decide what purpose or desire keeps you  bound to the Mortal Realm. When you fulfill it, you cross through the veil of death.",
		"category": "transformation",
		"type": "feature",
		"source": "SRD",
		"transformation": "Ghost"
	},
	"ephemeral": {
		"description": "Your body wavers in and out of being corporeal.\nYou are resistant to physical damage, take double magic damage, and can mark 2 Stress to momentarily pass through a solid object.",
		"category": "transformation",
		"type": "feature",
		"source": "SRD",
		"transformation": "Ghost",
		"stress": -2
	},
	"corpse": {
		"description": "During a rest, you can clear Hit Points only if you have access to remains from a recently deceased creature. Describe how you use these materials to maintain your corpse.",
		"category": "transformation",
		"type": "feature",
		"source": "SRD",
		"transformation": "Reanimated"
	},
	"won't stay dead": {
		"description": "When you choose the Risk It All death move and fail, you can permanently mark a Hit Point to succeed instead. When you do, you still use the Hope Die\u2019s value to clear Hit Points and Stress. When you permanently mark your last Hit Point, you pass through the veil of death.",
		"category": "transformation",
		"type": "feature",
		"source": "SRD",
		"transformation": "Reanimated"
	},
	"change shape": {
		"description": "During a rest, you can use a downtime move to swap your current ancestry with another. When you do, describe how your appearance changes.",
		"category": "transformation",
		"type": "feature",
		"source": "SRD",
		"transformation": "Shapeshifter"
	},
	"only skin deep": {
		"description": "You gain the benefit of only one of your chosen ancestry\u2019s features, which you select when you choose the ancestry. You can use a downtime move to choose a different feature from that ancestry.",
		"category": "transformation",
		"type": "feature",
		"source": "SRD",
		"transformation": "Shapeshifter"
	},
	"fangs": {
		"description": "Make an attack using a trait of your choice to bite a target within Melee range. On a success, deal d6 physical damage using your Proficiency.",
		"category": "transformation",
		"type": "feature",
		"source": "SRD",
		"transformation": "Vampire"
	},
	"feed": {
		"description": "On a successful \u201cFangs\u201d attack against a creature that can bleed, you can mark a Stress to feed. Place a number of tokens on this card equal to the number of Hit Points the target marks. You can hold up to 6 tokens at a time. Before you make an action roll, you can spend a token to make your Fear Die a d20. When you take a long rest, remove a token.\nWhile there are no tokens on this card, you make action and reaction rolls with disadvantage.",
		"category": "transformation",
		"type": "feature",
		"source": "SRD",
		"transformation": "Vampire",
		"stress": -1
	},
	"wolf form": {
		"description": "When you mark 1 or more Hit Points, you can mark a Stress to enter your Wolf Form. While in this form, you gain a 1d10 bonus to attack and damage rolls. When you roll with Hope while in Wolf Form, you must mark a Stress. Your Wolf Form lasts until you go into your \u201cHowling Rampage\u201d or take a rest.",
		"category": "transformation",
		"type": "feature",
		"source": "SRD",
		"transformation": "Werewolf",
		"stress": -1
	},
	"howling rampage": {
		"description": "When you mark your last Stress while in Wolf Form, you go into a rampage. Roll a number of d20s equal to your tier and deal that much physical damage to all creatures within Very Close range, then drop out of Wolf Form.",
		"category": "transformation",
		"type": "feature",
		"source": "SRD",
		"transformation": "Werewolf"
	}
}